---
/**
 * ============================================================================
 *  GLOBO 3D (México · España · Nueva York) — Conóceme, tras «Mi trayectoria»
 * ============================================================================
 *  Capas, de abajo arriba, en una caja cuadrada reservada (aspect-ratio → sin CLS):
 *  1. Póster estático: el MISMO globo renderizado con cobe y la misma vista
 *     (src/assets/globe-poster.png, `npm run globe-poster`), AVIF/WebP y diferido.
 *     Es el globo antes de hidratar, sin JavaScript, sin WebGL y con «reducir movimiento».
 *  2. Isla de React <Globe client:visible> (WebGL, cobe): se funde sobre el póster cuando
 *     tiene su primer fotograma completo (data-globe="live").
 *  3. Etiquetas HTML de los tres lugares (posición inicial calculada aquí con la misma
 *     proyección; la isla las desplaza con transform mientras gira).
 *  Accesibilidad: la caja es role="img" con texto alternativo; lienzo y etiquetas son
 *  decorativos (aria-hidden). Pie visible: «México · España · Nueva York».
 * ============================================================================
 */
import { Picture } from 'astro:assets';
import Globe from './Globe';
import { PLACES, VIEW, project } from './globe-config';
import poster from '~/assets/globe-poster.png';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const labels = PLACES.map((place) => {
  const q = project(place.location, VIEW.phi, VIEW.theta);
  return { ...place, x: (q.x * 100).toFixed(2), y: (q.y * 100).toFixed(2) };
});
// Pie (docs/contenido.md): México · España · Nueva York
const caption = ['México', 'España', 'Nueva York'];
---

<figure class:list={['globe-slot', className]} data-globe-slot>
  <div
    class="globe-stage"
    role="img"
    aria-label="Globo terráqueo con tres puntos marcados, México, Madrid (España) y Nueva York, unidos por arcos."
  >
    <Picture
      src={poster}
      alt=""
      widths={[400, 560, 720, 960]}
      sizes="(min-width: 540px) 480px, calc(100vw - 2rem)"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
      class="globe-poster"
    />
    <Globe client:visible={{ rootMargin: '240px' }} />
    <ul class="globe-labels" role="list" aria-hidden="true">
      {
        labels.map((l) => (
          <li class:list={['globe-label', `globe-label--${l.side}`]} data-globe-label={l.id} style={`left:${l.x}%;top:${l.y}%`}>
            {l.label}
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption class="globe-caption">
    {
      caption.map((label, i) => (
        <>
          {i > 0 && <span class="globe-caption-sep" aria-hidden="true">·</span>}
          <span>{label}</span>
        </>
      ))
    }
  </figcaption>
</figure>

<style>
  .globe-slot {
    position: relative;
    width: min(100%, 480px);
    margin: 0 auto;
  }
  .globe-stage {
    position: relative;
    aspect-ratio: 1;
    isolation: isolate;
  }
  /* Halo ciruela muy suave bajo el globo */
  .globe-stage::before {
    content: "";
    position: absolute;
    inset: 14% 12% 6%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(110, 29, 122, .16), transparent);
    filter: blur(28px);
    pointer-events: none;
  }

  .globe-stage :global(.globe-poster),
  .globe-stage :global(.globe-poster img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .globe-stage :global(picture) {
    position: absolute;
    inset: 0;
    transition: opacity 520ms var(--ease-out);
  }

  /* Isla WebGL: ocupa la misma caja; el lienzo se funde cuando ya tiene su primer fotograma
     (entrada → ease-out; decorativo, puede durar algo más que la UI). */
  .globe-stage :global(astro-island),
  .globe-stage :global(.globe-gl) {
    position: absolute;
    inset: 0;
  }
  .globe-stage :global(.globe-gl-wrap),
  .globe-stage :global(.globe-canvas) {
    width: 100% !important;
    height: 100% !important;
  }
  .globe-stage :global(.globe-canvas) {
    display: block;
    opacity: 0;
    transition: opacity 520ms var(--ease-out);
    touch-action: pan-y;            /* en táctil, el gesto vertical desplaza la página */
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .globe-stage :global(.globe-canvas) { cursor: grab; }
    [data-dragging] .globe-stage :global(.globe-canvas) { cursor: grabbing; }
  }
  [data-globe="live"] .globe-stage :global(.globe-canvas) { opacity: 1; }
  [data-globe="live"] .globe-stage :global(picture) { opacity: 0; }

  /* Etiquetas: posición inicial en % (mismo encuadre que el póster); `translate` coloca la
     etiqueta junto al punto y la isla añade `transform` mientras gira. */
  .globe-labels {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .globe-label {
    position: absolute;
    padding: .2rem .55rem .22rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, .82);
    box-shadow: 0 1px 2px rgba(44, 10, 50, .06), 0 4px 14px -6px rgba(44, 10, 50, .25);
    color: var(--c-plum-800);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform;
  }
  .globe-label--below { translate: -50% .7rem; }
  .globe-label--above { translate: -50% calc(-100% - .7rem); }
  .globe-label--left { translate: calc(-100% - .8rem) -50%; }
  .globe-label--right { translate: .8rem -50%; }
  @media (min-width: 600px) {
    .globe-label { font-size: .72rem; }
  }

  .globe-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: .35rem .7rem;
    margin-top: .25rem;
    color: var(--c-plum);
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .2em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .globe-caption-sep { color: var(--c-plum); opacity: .6; }
</style>
