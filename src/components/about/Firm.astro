---
/**
 * «El despacho» (Conóceme, debajo del bloque principal de Denisse): Nuestra historia, Nuestra
 * misión y Nuestros valores (web anterior, docs/web-anterior.md §3, tal cual con sus correcciones
 * ortográficas §8), «Nuestro equipo» (docs/cambios-2026-10.md §3) y «Partners» (§4,
 * components/about/Partners.astro; sustituye al bloque «Partner en Dubái»).
 * Fotos: Everardo y Stephanie, recortes de _originales/web-anterior/
 * (scripts/prepare-web-anterior-images.mjs); Denisse, de _originales/recursos-2026-10/
 * (scripts/prepare-recursos-2026-10.mjs).
 * Componente independiente: no toca el bloque principal de /conoceme/.
 */
import type { ImageMetadata } from 'astro';
import { SITE } from '~/data/site';
import Photo from '../ui/Photo.astro';
import Partners from './Partners.astro';
// Denisse: foto nueva del despacho (docs/cambios-2026-10.md §3); Everardo y Stephanie, las de antes.
import denisse from '~/assets/img/equipo/denisse-despacho.jpg';
import everardo from '~/assets/img/equipo/everardo-corona.jpg';
import stephanie from '~/assets/img/equipo/stephanie-gonzalez.jpg';

const values = [
  { title: 'Cercanía', text: 'Escuchamos y entendemos las historias detrás de cada trámite.' },
  { title: 'Excelencia jurídica', text: 'Ofrecemos asesoría basada en rigor legal, actualización constante y experiencia real.' },
  { title: 'Transparencia', text: 'Comunicación clara, sin promesas falsas ni procesos ocultos.' },
  { title: 'Compromiso', text: 'Cada caso es único, y lo tratamos con dedicación y respeto.' },
  { title: 'Visión internacional', text: 'Pensamos a largo plazo y acompañamos a nuestros clientes más allá de las fronteras.' },
];

// «Nuestro equipo»: textos y cargos nuevos, tal cual (docs/cambios-2026-10.md §3; sustituyen a
// los de la web antigua). Everardo Corona NO aparece como cofundador de nada.
// (Ficha sin foto: iniciales en el mismo círculo que los retratos, si algún miembro no tiene foto.)
type Member = {
  name: string;
  role: string;
  photo?: ImageMetadata;
  alt?: string;
  initials?: string;
  position?: string;
  bio: string[];
};
const team: Member[] = [
  {
    name: 'Denisse González',
    role: 'Presidenta y fundadora de DG · Cofundadora de Empoderando Voces',
    photo: denisse,
    alt: 'Retrato de Denisse González en su despacho, con blazer burdeos',
    position: '50% 40%',
    bio: [
      'Denisse González es fundadora y presidenta de DG, firma que creó y dirige, liderando su visión, estrategia y desarrollo. Especializada en Derecho Internacional, cuenta con experiencia en asuntos jurídicos, movilidad internacional y relaciones institucionales.',
      'Su trayectoria se caracteriza por una visión estratégica, vocación internacional y compromiso con ofrecer soluciones claras, eficaces y orientadas a resultados. Asimismo, es cofundadora de Empoderando Voces, iniciativa internacional dedicada a la promoción de la dignidad humana, los derechos humanos y el fortalecimiento de las comunidades.',
    ],
  },
  {
    name: 'Everardo Corona',
    role: 'Embajador de México en retiro · Socio de DG · Cofundador de Empoderando Voces',
    photo: everardo,
    alt: 'Retrato de Everardo Corona con traje oscuro y corbata',
    bio: [
      'Everardo Corona, Embajador de México en retiro, desarrolló su trayectoria en el ámbito diplomático y fue representante de México en España. Actualmente es socio de DG, aportando su experiencia en relaciones diplomáticas, institucionales y empresariales internacionales.',
      'Es además cofundador de Empoderando Voces, donde contribuye al fortalecimiento de relaciones institucionales y a su proyección internacional. Su experiencia y trayectoria aportan una perspectiva estratégica al desarrollo de proyectos y alianzas con instituciones y socios internacionales.',
    ],
  },
  {
    name: 'Stephanie González',
    role: 'Directora técnica de DG · Cofundadora de Empoderando Voces',
    photo: stephanie,
    alt: 'Stephanie González con blusa roja junto a una estatua de la Justicia',
    bio: [
      'Stephanie González es directora técnica de DG, donde supervisa la correcta aplicación de criterios, procedimientos y estándares de calidad, procurando que cada asunto sea gestionado con rigor, precisión y profesionalismo.',
      'Asimismo, es cofundadora de Empoderando Voces, participando en el desarrollo y ejecución de sus proyectos. Su perfil combina capacidad técnica, organización y compromiso con la excelencia, contribuyendo al fortalecimiento de la firma y de las iniciativas de impacto social.',
    ],
  },
];
---

<section class="section section--white firm" id="despacho" aria-labelledby="firm-title">
  <div class="container firm-grid">
    <header class="firm-head">
      <p class="eyebrow" data-reveal>El despacho</p>
      <h2 class="section-title firm-title" id="firm-title" data-reveal>{SITE.firm}</h2>
    </header>

    <div class="firm-body">
      <div class="firm-block" data-reveal>
        <h3 class="firm-subtitle">Nuestra historia</h3>
        <div class="prose">
          <p class="prose-lead">Este despacho nace con una visión clara: brindar soluciones legales efectivas, humanas y confiables a personas extranjeras y emprendedores que buscan construir un futuro sólido en México, España o expandirse a Dubái.</p>
          {/* PENDIENTE (cliente): confirmar la redacción. Su texto decía «con dos maestrías, una en
              Estados Unidos por California Western School of Law y otra en España por el ISDE»; se
              añade el Máster en Gestión Administrativa (UAX) y «gestora administrativa»
              (docs/cambios-2026-10.md §1) para no contradecir la trayectoria de esta misma página. */}
          <p>Fundado por Denisse Elena González, consultora internacional, abogada titulada en México y gestora administrativa titulada en España, con estudios de posgrado en Estados Unidos, por California Western School of Law, y en España, por el Instituto Superior de Derecho y Economía (ISDE) y la UAX. Especializada en extranjería y creación de empresas internacionales, el proyecto crece desde una vocación profunda de servicio, excelencia legal y compromiso con el éxito de cada cliente.</p>
          <p>Hoy, somos una firma que combina experiencia jurídica, atención personalizada y una mirada estratégica para acompañar a quienes desean avanzar legalmente y sin complicaciones.</p>
        </div>
      </div>

      <div class="firm-mission" data-reveal>
        <h3 class="firm-subtitle firm-subtitle--plum">Nuestra misión</h3>
        <p class="mission-statement">Ofrecer un servicio legal claro, profesional y accesible, centrado en la persona.</p>
        <p class="mission-text">Acompañamos a nuestros clientes en sus procesos migratorios y empresariales con estrategias legales personalizadas, enfocadas en resultados reales y duraderos, tanto en México, España como en Dubái.</p>
      </div>
    </div>

    <div class="firm-values">
      <h3 class="firm-subtitle" data-reveal>Nuestros valores</h3>
      <ol class="values" role="list">
        {
          values.map((v, i) => (
            <li class="value" data-reveal>
              <span class="value-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h4 class="value-title">{v.title}</h4>
              <p class="value-text">{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section class="section section--ivory team" id="equipo" aria-labelledby="team-title">
  <div class="container">
    <div class="team-head">
      <p class="eyebrow" data-reveal>{SITE.firm}</p>
      <h2 class="section-title" id="team-title" data-reveal>Nuestro equipo</h2>
      <p class="lead" data-reveal>Profesionales especializados que se encargan de nuestro éxito.</p>
    </div>

    <ul class="team-grid" role="list">
      {
        team.map((m) => (
          <li class="member" data-reveal>
            {m.photo ? (
              <figure class="member-photo">
                <Photo src={m.photo} alt={m.alt ?? ''} widths={[160, 240, 320]} sizes="(min-width: 600px) 152px, 88px" position={m.position} />
              </figure>
            ) : (
              <div class="member-photo member-photo--initials" aria-hidden="true">
                <span>{m.initials}</span>
              </div>
            )}
            <div class="member-copy">
              <h3 class="member-name">{m.name}</h3>
              <p class="member-role">{m.role}</p>
              <div class="member-bio">
                {m.bio.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<Partners />

<style>
  /* ---------- El despacho ---------- */
  .firm-grid { display: grid; gap: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 6rem); }
  .firm-title { max-width: 7em; }
  .firm-body { display: grid; gap: clamp(2.5rem, 5vw, 3.5rem); }
  .firm-subtitle {
    display: inline-flex;
    align-items: center;
    gap: .85em;
    margin-bottom: 1.1rem;
    color: var(--c-ink);
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .firm-subtitle::before { content: ""; width: 2rem; height: 1px; background: var(--c-plum); }
  .firm-subtitle--plum { color: var(--c-plum); }

  .firm-mission {
    position: relative;
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    background: var(--c-lavender);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  .mission-statement {
    font-family: var(--ff-serif);
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.1rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.28;
    color: var(--c-plum-800);
    text-wrap: balance;
  }
  .mission-text { max-width: 36em; margin-top: 1.1rem; color: var(--c-ink-soft); text-wrap: pretty; }

  .firm-values { min-width: 0; }
  .values { display: grid; border-top: 1px solid var(--c-line); }
  .value {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: .5rem;
    padding: 1.25rem 0 1.35rem;
    border-bottom: 1px solid var(--c-line);
  }
  .value-num { grid-row: span 2; padding-top: .35rem; color: var(--c-plum); font-size: .78rem; font-weight: 600; letter-spacing: .16em; }
  .value-title { font-family: var(--ff-serif); font-size: clamp(1.35rem, 1.2rem + .5vw, 1.6rem); font-weight: 600; line-height: 1.2; }
  .value-text { margin-top: .3rem; color: var(--c-ink-soft); line-height: 1.55; text-wrap: pretty; }

  @media (min-width: 960px) {
    .firm-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      grid-template-areas: "head body" "values values";
    }
    .firm-head { grid-area: head; align-self: start; }
    .firm-body { grid-area: body; }
    .firm-values { grid-area: values; margin-top: clamp(1rem, 3vw, 2.5rem); }
    .values { grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: 1.75rem; border-top: 0; }
    .value {
      grid-template-columns: 1fr;
      align-content: start;
      padding: 1.4rem 0 0;
      border-top: 1px solid var(--c-line-strong);
      border-bottom: 0;
    }
    .value-num { grid-row: auto; padding-top: 0; margin-bottom: .6rem; }
  }

  /* ---------- Equipo ---------- */
  .team-head { max-width: 46rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .team-head .section-title { margin-bottom: 1rem; }
  .team-grid { display: grid; gap: clamp(2rem, 4vw, 3rem) clamp(2rem, 5vw, 4.5rem); }
  /* Retrato circular y pequeño (como en su web anterior): las fotos originales son de baja
     resolución y así se ven nítidas. */
  .member {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1.25rem 1.5rem;
    align-items: start;
  }
  .member-photo {
    margin: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--c-lavender-200);
    box-shadow: 0 0 0 1px var(--c-line), 0 0 0 6px var(--c-white), 0 0 0 7px var(--c-lavender-300);
  }
  @media (max-width: 599.98px) { .member-photo { margin-inline-start: 7px; } }
  .member-photo :global(picture),
  .member-photo :global(img) { width: 100%; height: 100%; }
  .member-photo :global(img) { object-fit: cover; }
  /* Sin foto: sus iniciales en serif sobre lavanda, mismo círculo y mismo anillo. */
  .member-photo--initials {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 30% 15%, var(--c-white), transparent 60%),
      var(--c-lavender);
  }
  .member-photo--initials span {
    font-family: var(--ff-serif);
    font-size: 2.6rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: .04em;
    color: var(--c-plum);
  }
  .member-copy { padding-top: .35rem; }
  .member-name { font-family: var(--ff-serif); font-size: var(--fs-h4); font-weight: 600; line-height: 1.12; }
  .member-role {
    margin-top: .4rem;
    color: var(--c-plum);
    font-size: .74rem;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.45;
    text-transform: uppercase;
  }
  .member-bio { display: grid; gap: .75rem; margin-top: 1rem; color: var(--c-ink-soft); font-size: var(--fs-small); line-height: 1.65; text-wrap: pretty; }

  /* Móvil: nombre y cargo junto al retrato; la biografía ocupa todo el ancho para no quedar en
     una columna estrecha. */
  @media (max-width: 599.98px) {
    .member { grid-template-columns: 88px minmax(0, 1fr); column-gap: 1.25rem; row-gap: .35rem; }
    .member-copy { display: contents; }
    .member-photo { grid-row: 1 / span 2; align-self: center; }
    .member-name, .member-role { grid-column: 2; }
    .member-name { align-self: end; }
    .member-role { align-self: start; margin-top: 0; }
    .member-bio { grid-column: 1 / -1; margin-top: .9rem; }
    .member-photo--initials span { font-size: 2.1rem; }
  }
  @media (min-width: 600px) {
    .member { grid-template-columns: 152px minmax(0, 1fr); gap: 2rem; }
    .member-photo--initials span { font-size: 3.4rem; }
  }
  /* Escritorio: Denisse (fundadora) a todo el ancho, con sus dos párrafos en dos columnas para
     no alargar las líneas; Everardo y Stephanie, debajo, en dos columnas. Con tres fichas en una
     rejilla de 2 quedaba Stephanie sola y una celda vacía a su lado. */
  @media (min-width: 1024px) {
    .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .member:first-child {
      grid-column: 1 / -1;
      padding-bottom: clamp(2rem, 4vw, 3rem);
      border-bottom: 1px solid var(--c-line);
    }
    .member:first-child .member-bio { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem clamp(2rem, 4vw, 3.5rem); }
  }

</style>
