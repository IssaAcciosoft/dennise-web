---
/**
 * Formulario de contacto (/contacto/) → formulario «contacto» de AccioGest
 * (docs/integracion-acciogest.md §4). Sin email ni dirección visibles hasta que la cliente
 * los facilite (README → Pendiente).
 */
import { WA_TEXT } from '~/data/site';
import LeadForm from '../forms/LeadForm.astro';
import Field from '../forms/Field.astro';

const p = 'cf';
---

<section class="section section--white contact-form-section" id="formulario-contacto" aria-labelledby="contact-form-title" data-wa-hide>
  <div class="container contact-form-grid">
    <div class="contact-form-intro">
      <p class="eyebrow">Formulario de contacto</p>
      <h2 class="section-title" id="contact-form-title">Envíame un mensaje.</h2>
      <p class="lead contact-form-lead">Cuéntame brevemente tu caso o tu consulta.</p>
      <p class="contact-form-req">
        Los campos marcados con <span aria-hidden="true">*</span><span class="visually-hidden">asterisco</span> son obligatorios.
      </p>
    </div>

    <div class="contact-form-card">
      <LeadForm
        formKey="contacto"
        idPrefix={p}
        submitLabel="Enviar mensaje"
        successTitle="¡Mensaje enviado!"
        successText="He recibido tu mensaje correctamente."
        waText={WA_TEXT.general}
      >
        <Field name="nombre" id={`${p}-nombre`} label="Nombre" required autocomplete="name" maxlength={120} msgRequired="Escribe tu nombre." />
        <Field
          name="email"
          id={`${p}-email`}
          label="Email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          maxlength={160}
          msgRequired="Escribe tu email para que pueda responderte."
        />
        <Field name="telefono" id={`${p}-telefono`} label="Teléfono" type="tel" autocomplete="tel" inputmode="tel" maxlength={25} full />
        <Field
          name="mensaje"
          id={`${p}-mensaje`}
          label="Mensaje"
          type="textarea"
          required
          full
          rows={6}
          minlength={10}
          maxlength={2000}
          counter
          msgRequired="Escribe tu mensaje."
          msgMinlength="Tu mensaje es muy breve: escribe al menos 10 caracteres."
        />
      </LeadForm>
    </div>
  </div>
</section>

<script>
  import { initLeadForm } from '~/scripts/lead-form';
  initLeadForm(document.querySelector<HTMLElement>('[data-lead="contacto"]'));
</script>

<style>
  .contact-form-section { scroll-margin-top: var(--header-h); }
  .contact-form-grid { display: grid; gap: 2.5rem; }
  .contact-form-intro .section-title { margin-bottom: 1.25rem; }
  .contact-form-lead { max-width: 26rem; }
  .contact-form-req { margin-top: 1.25rem; color: var(--c-muted); font-size: var(--fs-small); }
  .contact-form-card {
    padding: clamp(1.25rem, .75rem + 2.5vw, 2.75rem);
    background: var(--c-ivory);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
  }
  @media (min-width: 960px) {
    .contact-form-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); column-gap: 5rem; align-items: start; }
    .contact-form-intro { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>
