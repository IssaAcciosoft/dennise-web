---
/**
 * Hero del inicio. Texto de la cliente, tal cual (docs/contenido.md §4 «HERO», recibido el
 * 02/10): titular (H1), firma (nombre + áreas), dos párrafos y el par de cierre.
 * El H1 es el LCP en móvil: nunca se oculta ni se anima (sin data-reveal en el hero).
 * «Derecho con estrategia…» ya no está aquí: es el cierre de «Más allá del expediente».
 */
import { BOOKING_PATH, SITE, OFFICE } from '~/data/site';
import { url } from '~/lib/url';
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import retrato from '~/assets/img/retrato.jpg';
---

<section class="hero" aria-labelledby="hero-title" data-wa-hide>
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title" id="hero-title">Derecho que conecta <em>personas, oportunidades y&nbsp;derechos</em></h1>
      <p class="hero-signature">
        <span class="hero-signature-name">Denisse González</span>
        <span class="hero-signature-areas">
          <span class="nowrap">Derecho internacional</span><span class="hero-dot" aria-hidden="true"> · </span><span class="nowrap">Movilidad internacional</span><span class="hero-dot" aria-hidden="true"> · </span><span class="nowrap">Derechos humanos</span>
        </span>
      </p>
      <div class="hero-text">
        <p>Entre personas, instituciones y fronteras existen caminos que no siempre son fáciles de recorrer.</p>
        <p>Mi trabajo consiste en ayudar a construir esos caminos con conocimiento jurídico, visión internacional y, sobre todo, con una mirada humana.</p>
      </div>
      <p class="hero-closing">
        <span>Conocer el derecho es importante.</span>
        <span>Entender a las personas que necesitan de él lo es aún más.</span>
      </p>
      <div class="btn-row hero-actions">
        <a class="btn btn--primary btn--lg" href={url(BOOKING_PATH)}>
          <Icon name="calendar" />
          <span>Reserva tu asesoría</span>
        </a>
        <a class="btn btn--ghost btn--lg" href={url('/conoceme/')}>
          <span>Conóceme</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <div class="hero-media">
      <div class="hero-arch vt-portrait">
        <Photo
          src={retrato}
          alt="Denisse González, abogada, sonriendo con blazer morado"
          widths={[360, 480, 600, 732]}
          sizes="(min-width: 960px) 450px, (min-width: 600px) 440px, calc(100vw - 2rem)"
          priority
          position="50% 62%"
        />
      </div>
      <p class="hero-badge">
        <span class="hero-badge-name">{SITE.firm}</span>
        <span class="hero-badge-role">Despacho en {OFFICE.locality}</span>
      </p>
    </div>
  </div>
  <slot />
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 1.25rem + 4vw, 5rem);
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    overflow: clip;
    background:
      radial-gradient(60rem 40rem at 100% 0%, rgba(232, 221, 236, .85), transparent 62%),
      radial-gradient(40rem 30rem at 0% 100%, rgba(247, 238, 232, .9), transparent 70%),
      var(--c-ivory);
  }
  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  /* Jerarquía: titular (serif, H1) → firma (nombre + áreas) → dos párrafos → par de cierre
     destacado → botones. Anchos en em (nunca ch: CLS al cambiar de fuente). */
  .hero-title {
    max-width: 11.5em;
    margin-bottom: clamp(1.35rem, 1rem + 1vw, 1.9rem);
    font-family: var(--ff-serif);
    font-size: clamp(2.35rem, 1.45rem + 3.5vw, 4.4rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--c-ink);
    text-wrap: balance;
  }
  .hero-title em { font-style: italic; font-weight: 500; color: var(--c-plum); }

  .hero-signature {
    display: grid;
    gap: .3rem;
    margin-bottom: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    padding-left: 1rem;
    border-left: 1px solid var(--c-line-strong);
  }
  .hero-signature-name {
    font-family: var(--ff-serif);
    font-size: clamp(1.3rem, 1.2rem + .4vw, 1.5rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--c-ink);
  }
  /* Áreas: en una línea si cabe con holgura; si no, una por línea. Lo decide el ancho del
     contenedor (no el de la fuente), así el cambio de fuente nunca reorganiza la línea (CLS). */
  .hero-signature { container-type: inline-size; }
  .hero-signature-areas {
    display: flex;
    flex-wrap: nowrap;
    color: var(--c-plum);
    font-size: .74rem;
    font-weight: 600;
    letter-spacing: .15em;
    line-height: 1.7;
    text-transform: uppercase;
  }
  .hero-dot { color: var(--c-grey); white-space: pre; }
  @container (max-width: 37rem) {
    .hero-signature-areas { flex-direction: column; }
    .hero-dot { display: none; }
  }

  .hero-text {
    display: grid;
    gap: .85rem;
    max-width: 34em;
    color: var(--c-ink-soft);
    font-size: clamp(1.08rem, 1rem + .3vw, 1.22rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero-closing {
    display: grid;
    gap: .15rem;
    max-width: 26em;
    margin-block: clamp(1.5rem, 1.2rem + 1vw, 2rem) clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-family: var(--ff-serif);
    font-size: clamp(1.32rem, 1.15rem + .7vw, 1.7rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.28;
    color: var(--c-ink);
    text-wrap: balance;
  }
  .hero-closing span:last-child { color: var(--c-plum); }
  .hero-closing::before {
    content: "";
    display: block;
    width: .5rem;
    height: .5rem;
    margin-bottom: .9rem;
    background: var(--c-plum);
    rotate: 45deg;
  }

  .hero-media {
    position: relative;
    isolation: isolate;
    width: min(100% - 1.5rem, 440px);
    justify-self: center;
    margin-bottom: 1.25rem;
  }
  .hero-arch {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-pill) var(--radius-pill) 18px 18px;
    overflow: hidden;
    background: var(--c-lavender-200);
    box-shadow: var(--shadow);
  }
  .hero-arch :global(picture),
  .hero-arch :global(img) { width: 100%; height: 100%; }
  .hero-arch :global(img) { object-fit: cover; }
  .hero-media::before {
    content: "";
    position: absolute;
    inset: -10px -8px 10px 8px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-pill) var(--radius-pill) 22px 22px;
    pointer-events: none;
  }
  .hero-media::after {
    content: "";
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    right: -16%;
    bottom: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 29, 122, .14), transparent 70%);
    z-index: -1;
  }

  .hero-badge {
    position: absolute;
    left: .5rem;
    bottom: -1rem;
    display: flex;
    flex-direction: column;
    padding: .85rem 1.2rem .95rem;
    background: var(--c-white);
    border-radius: 12px;
    box-shadow: var(--shadow-s);
    border-left: 3px solid var(--c-plum);
  }
  .hero-badge-name {
    font-family: var(--ff-serif);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .hero-badge-role {
    margin-top: .2rem;
    color: var(--c-muted);
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  @media (max-width: 479.98px) {
    .hero-actions .btn { width: 100%; }
  }
  @media (min-width: 600px) {
    .hero-media::before { inset: -14px -14px 14px 14px; }
    .hero-badge { left: -1rem; bottom: -1.25rem; }
  }
  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1.32fr) minmax(0, .68fr); gap: clamp(2.5rem, 4vw, 4rem); }
    .hero-media { width: 100%; max-width: 450px; justify-self: end; margin-bottom: 0; }
    .hero-badge { left: -2.5rem; bottom: 2.5rem; }
  }
</style>
