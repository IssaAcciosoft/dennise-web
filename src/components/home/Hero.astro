---
import { BOOKING_PATH } from '~/data/site';
import { url } from '~/lib/url';
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import retrato from '~/assets/img/retrato.jpg';
---

<section class="hero" aria-labelledby="hero-title" data-wa-hide>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">
        <span>Abogada&nbsp;· Extranjería&nbsp;· <span class="nowrap">Derecho internacional</span>&nbsp;· <span class="nowrap">Derechos humanos</span></span>
      </p>
      <h1 class="hero-title" id="hero-title">
        <span class="hero-line">Derecho con <em>estrategia.</em></span>
        <span class="hero-line">Derecho con <em>perspectiva internacional.</em></span>
        <span class="hero-line">Derecho con <em>humanidad.</em></span>
      </h1>
      <p class="hero-lead">
        Porque detrás de cada expediente hay una persona. Y detrás de cada trámite, una historia, un proyecto de vida o una oportunidad que merece ser tomada en serio.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn btn--primary btn--lg" href={url(BOOKING_PATH)}>
          <Icon name="calendar" />
          <span>Reserva tu asesoría</span>
        </a>
        <a class="btn btn--ghost btn--lg" href={url('/conoceme/')}>
          <span>Conóceme</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <div class="hero-media">
      <div class="hero-arch">
        <Photo
          src={retrato}
          alt="Denisse González, abogada, sonriendo con blazer morado"
          widths={[360, 480, 600, 732]}
          sizes="(min-width: 960px) 450px, (min-width: 600px) 440px, calc(100vw - 2rem)"
          priority
          position="50% 62%"
        />
      </div>
      <p class="hero-badge">
        <span class="hero-badge-name">Denisse González</span>
        <span class="hero-badge-role">Abogada · Mtra. en Derecho</span>
      </p>
    </div>
  </div>
  <slot />
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 1.25rem + 4vw, 5rem);
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    overflow: clip;
    background:
      radial-gradient(60rem 40rem at 100% 0%, rgba(232, 221, 236, .85), transparent 62%),
      radial-gradient(40rem 30rem at 0% 100%, rgba(247, 238, 232, .9), transparent 70%),
      var(--c-ivory);
  }
  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .hero .eyebrow { letter-spacing: .15em; }
  .hero-title {
    margin-bottom: 1.5rem;
    font-family: var(--ff-serif);
    font-size: var(--fs-h1);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--c-ink);
  }
  .hero-title em { font-style: italic; font-weight: 500; color: var(--c-plum); }
  .hero-line { display: block; }
  .hero-line + .hero-line { margin-top: .12em; }
  .hero-lead {
    max-width: 38rem;
    margin-bottom: 2rem;
    color: var(--c-ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-media {
    position: relative;
    isolation: isolate;
    width: min(100% - 1.5rem, 440px);
    justify-self: center;
    margin-bottom: 1.25rem;
  }
  .hero-arch {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-pill) var(--radius-pill) 18px 18px;
    overflow: hidden;
    background: var(--c-lavender-200);
    box-shadow: var(--shadow);
  }
  .hero-arch :global(picture),
  .hero-arch :global(img) { width: 100%; height: 100%; }
  .hero-arch :global(img) { object-fit: cover; }
  .hero-media::before {
    content: "";
    position: absolute;
    inset: -10px -8px 10px 8px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-pill) var(--radius-pill) 22px 22px;
    pointer-events: none;
  }
  .hero-media::after {
    content: "";
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    right: -16%;
    bottom: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 29, 122, .14), transparent 70%);
    z-index: -1;
  }

  .hero-badge {
    position: absolute;
    left: .5rem;
    bottom: -1rem;
    display: flex;
    flex-direction: column;
    padding: .85rem 1.2rem .95rem;
    background: var(--c-white);
    border-radius: 12px;
    box-shadow: var(--shadow-s);
    border-left: 3px solid var(--c-plum);
  }
  .hero-badge-name {
    font-family: var(--ff-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .hero-badge-role {
    margin-top: .2rem;
    color: var(--c-muted);
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  @media (max-width: 479.98px) {
    .hero .eyebrow { font-size: .72rem; letter-spacing: .12em; }
    .hero-actions .btn { width: 100%; }
  }
  @media (min-width: 600px) {
    .hero-media::before { inset: -14px -14px 14px 14px; }
    .hero-badge { left: -1rem; bottom: -1.25rem; }
  }
  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1.32fr) minmax(0, .68fr); gap: clamp(2.5rem, 4vw, 4rem); }
    .hero-media { width: 100%; max-width: 450px; justify-self: end; margin-bottom: 0; }
    .hero-badge { left: -2.5rem; bottom: 2.5rem; }
  }
</style>
