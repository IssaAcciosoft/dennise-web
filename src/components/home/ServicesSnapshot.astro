---
/** Resumen de servicios y precios (inicio), generado desde src/data/servicios.json. */
import { consultations, autogestiona, formatAmount, CATALOG } from '~/lib/services';
import { BOOKING_PATH } from '~/data/site';
import { url } from '~/lib/url';
import Icon from '../ui/Icon.astro';

const modalities = consultations[0]?.prices.map((p) => ({ modality: p.modality, label: p.label })) ?? [];
---

<section class="section section--ivory snapshot" id="servicios" aria-labelledby="snapshot-title">
  <div class="container">
    <div class="snapshot-head">
      <div>
        <p class="eyebrow" data-reveal>Servicios de extranjería</p>
        <h2 class="section-title" id="snapshot-title" data-reveal>Un trámite puede cambiar tu vida.</h2>
      </div>
      <p class="lead" data-reveal>Expertos en extranjería. Tu tranquilidad y confianza son nuestra prioridad. Contáctanos hoy y deja tu caso en manos profesionales.</p>
    </div>

    <div class="snapshot-grid">
      <div class="snapshot-card" data-reveal>
        <h3 class="snapshot-card-title">Asesorías</h3>
        <table class="price-table">
          <caption class="visually-hidden">Precios de las asesorías, online y presenciales</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Servicio</span></th>
              {modalities.map((m) => <th scope="col">{m.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              consultations.map((c) => (
                <tr>
                  <th scope="row">
                    <span class="row-name">{c.name}</span>
                    <span class="row-duration">{c.duration_label}</span>
                  </th>
                  {modalities.map((m) => {
                    const p = c.prices.find((x) => x.modality === m.modality);
                    return <td>{p ? <span class="amount">{formatAmount(p.amount)}&nbsp;€</span> : '—'}</td>;
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="snapshot-card snapshot-card--program" data-reveal>
        <h3 class="snapshot-card-title">{autogestiona.name}</h3>
        <ul class="plan-mini" role="list">
          {
            autogestiona.plans.map((p) => (
              <li class:list={{ 'is-featured': p.featured }}>
                <span class="plan-mini-name">{p.name}</span>
                <span class="amount">{formatAmount(p.amount)}&nbsp;€</span>
              </li>
            ))
          }
        </ul>
        <p class="snapshot-note">{CATALOG.tax_label}</p>
      </div>
    </div>

    <div class="btn-row snapshot-actions" data-reveal>
      <a class="btn btn--primary" href={url('/servicios/')}>
        <span>Ver servicios y precios</span>
        <Icon name="arrow" />
      </a>
      <a class="btn btn--ghost" href={url(BOOKING_PATH)}>
        <Icon name="calendar" />
        <span>Reserva tu asesoría</span>
      </a>
    </div>
  </div>
</section>

<style>
  .snapshot-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .snapshot-head .section-title { max-width: 6.75em; }
  .snapshot-head .lead { max-width: 34rem; }
  @media (min-width: 960px) {
    .snapshot-head { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); column-gap: 5rem; align-items: end; }
  }

  .snapshot-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 900px) {
    .snapshot-grid { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 1.5rem; }
  }

  .snapshot-card {
    padding: clamp(1.25rem, 1rem + 1.4vw, 2.25rem);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
  }
  .snapshot-card--program {
    background:
      radial-gradient(30rem 18rem at 100% 0%, rgba(213, 193, 220, .6), transparent 70%),
      var(--c-lavender);
    border-color: rgba(110, 29, 122, .14);
  }
  .snapshot-card-title {
    margin-bottom: 1rem;
    font-family: var(--ff-serif);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.15;
  }

  .price-table { width: 100%; border-collapse: collapse; font-variant-numeric: lining-nums tabular-nums; }
  .price-table th,
  .price-table td { padding: .9rem .5rem; border-top: 1px solid var(--c-line); text-align: right; vertical-align: middle; }
  .price-table thead th {
    padding-block: 0 .6rem;
    border-top: 0;
    color: var(--c-muted);
    font-size: .74rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .price-table th[scope="row"] { padding-left: 0; text-align: left; font-weight: 400; }
  .price-table td:last-child,
  .price-table thead th:last-child { padding-right: 0; }
  .row-name { display: block; font-family: var(--ff-serif); font-size: 1.2rem; font-weight: 600; line-height: 1.2; color: var(--c-ink); }
  .row-duration { display: block; margin-top: .15rem; color: var(--c-plum); font-size: .76rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .amount { font-family: var(--ff-serif); font-size: clamp(1.45rem, 1.25rem + .8vw, 1.8rem); font-weight: 600; color: var(--c-plum); white-space: nowrap; }

  .plan-mini { display: grid; }
  .plan-mini li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: .9rem 0;
    border-top: 1px solid rgba(110, 29, 122, .16);
  }
  .plan-mini-name { color: var(--c-ink); font-weight: 600; }
  .plan-mini li.is-featured .plan-mini-name::after {
    content: "";
    display: inline-block;
    width: .4rem;
    height: .4rem;
    margin-left: .6rem;
    vertical-align: .2rem;
    background: var(--c-plum);
    rotate: 45deg;
  }
  .snapshot-note {
    padding-top: .8rem;
    border-top: 1px solid rgba(110, 29, 122, .16);
    color: var(--c-muted);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .snapshot-actions { margin-top: clamp(2rem, 4vw, 3rem); }
</style>
