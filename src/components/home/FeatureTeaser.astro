---
/**
 * Bloque de presentación que enlaza a una página interna con frases de la propia cliente.
 * Imagen + antetítulo + título + texto (slot) + enlaces (slot "actions").
 */
import type { ImageMetadata } from 'astro';
import Photo from '../ui/Photo.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
  /** Lado de la imagen en escritorio. */
  side?: 'left' | 'right';
  frame?: 'tall' | 'arch';
  tone?: 'white' | 'ivory';
}
const { id, eyebrow, title, image, imageAlt, imagePosition, side = 'left', frame = 'tall', tone = 'white' } = Astro.props;
const headingId = `${id ?? 'teaser'}-title`;
---

<section class:list={['section', `section--${tone}`, 'teaser', `teaser--${side}`]} id={id} aria-labelledby={headingId}>
  <div class="container teaser-grid">
    <figure class="teaser-media" data-reveal="photo">
      <div class:list={['frame', `frame--${frame}`]}>
        <Photo src={image} alt={imageAlt} widths={[360, 540, 720, 900]} sizes="(min-width: 960px) 40vw, (min-width: 600px) 60vw, 90vw" position={imagePosition} />
      </div>
    </figure>
    <div class="teaser-copy">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 class="section-title teaser-title" id={headingId} data-reveal set:html={title} />
      <div class="prose teaser-text" data-reveal>
        <slot />
      </div>
      <div class="btn-row teaser-actions" data-reveal>
        <slot name="actions" />
      </div>
    </div>
  </div>
</section>

<style>
  .teaser-grid { display: grid; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .teaser-media { position: relative; isolation: isolate; width: min(100% - .75rem, 460px); justify-self: center; }
  .teaser-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .teaser-title { margin-bottom: 1.75rem; max-width: 8.6em; }
  .teaser-text { margin-bottom: 2.25rem; }
  @media (min-width: 960px) {
    .teaser-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .teaser--right .teaser-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .teaser--right .teaser-media { order: 2; }
    .teaser-media { justify-self: stretch; width: 100%; max-width: 480px; }
  }
</style>
