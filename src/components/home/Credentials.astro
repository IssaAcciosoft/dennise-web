---
/** Fila de credenciales (docs/contenido.md → HERO, «Credenciales cortas»). */
import Icon from '../ui/Icon.astro';
---

<div class="container">
  <ul class="trust-row" role="list" aria-label="Trayectoria en breve">
    <li class="trust-item trust-item--places">
      <Icon name="globe" />
      <span class="trust-title">México&nbsp;· España&nbsp;· <span class="nowrap">Nueva York</span></span>
    </li>
    <li class="trust-item">
      <span class="trust-title">Ex Directora Legal México</span>
      <span class="trust-sub">Poplavsky International Law Offices</span>
    </li>
    <li class="trust-item">
      <span class="trust-title">Asuntos Jurídicos</span>
      <span class="trust-sub">Embajada de México en España</span>
    </li>
    <li class="trust-item">
      <span class="trust-title">Delegada</span>
      <span class="trust-sub">International Human Rights Summit 2026 (<span class="nowrap">Nueva York</span>)</span>
    </li>
  </ul>
</div>

<style>
  .trust-row {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--c-line);
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    gap: .2rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--c-line);
  }
  .trust-item :global(.icon) { width: 1.4rem; height: 1.4rem; color: var(--c-plum); margin-bottom: .35rem; }
  .trust-title {
    font-family: var(--ff-serif);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--c-ink);
  }
  .trust-sub { color: var(--c-muted); font-size: .9rem; line-height: 1.45; }

  @media (min-width: 600px) {
    .trust-row { grid-template-columns: 1fr 1fr; column-gap: 2rem; }
  }
  @media (min-width: 960px) {
    .trust-row { grid-template-columns: 1.05fr 1fr 1fr 1.1fr; border-bottom: 1px solid var(--c-line); }
    .trust-item { border-bottom: 0; padding: 1.6rem 1.5rem; }
    .trust-item:first-child { padding-left: 0; }
    .trust-item + .trust-item { border-left: 1px solid var(--c-line); }
  }
</style>
