---
/**
 * Datos estructurados (schema.org) con URLs absolutas: WebSite, LegalService (el despacho,
 * «DG Gestores y Abogados», con email, teléfono y dirección), Person (fundadora) y WebPage.
 * Solo hechos de docs/contenido.md: sin idiomas (knowsLanguage) ni zona de servicio
 * (areaServed) hasta que la cliente los confirme. El NIE NUNCA va aquí (solo páginas legales).
 */
import { getImage } from 'astro:assets';
import { SITE, PHONE, SOCIALS, EMAIL, OFFICE } from '~/data/site';
import { consultations, autogestiona, immigration, dubai, minAmount, maxAmount, formatAmount, CATALOG } from '~/lib/services';
import { absoluteUrl } from '~/lib/url';
import retrato from '~/assets/img/retrato.jpg';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Páginas noindex: sin nodo WebPage (no se declara como página indexable). */
  noindex?: boolean;
}
const { title, description, path, noindex = false } = Astro.props;
const site = Astro.site;
const home = absoluteUrl('/', site);
const pageUrl = absoluteUrl(path, site);
const portrait = await getImage({ src: retrato, format: 'jpg', width: 732 });
const portraitUrl = absoluteUrl(portrait.src, site);
const sameAs = SOCIALS.map((s) => s.href);
const currency = CATALOG.currency;

const offers = [
  ...consultations.flatMap((c) =>
    c.prices.map((p) => ({
      '@type': 'Offer',
      name: `${c.name} · ${c.duration_label} (${p.label.toLowerCase()})`,
      price: String(p.amount),
      priceCurrency: currency,
    })),
  ),
  ...autogestiona.plans.map((p) => ({
    '@type': 'Offer',
    name: `${autogestiona.name} · ${p.name}`,
    price: String(p.amount),
    priceCurrency: currency,
  })),
];
// Servicios sin precio publicado (se solicitan por el formulario): Offer → Service, sin price.
const serviceOffer = (name: string) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } });

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: SITE.title,
      inLanguage: 'es',
      publisher: { '@id': `${home}#despacho` },
    },
    {
      '@type': 'LegalService',
      '@id': `${home}#despacho`,
      name: SITE.firm,
      url: home,
      description:
        'Despacho de Denisse González en Madrid: extranjería y asesoría migratoria online y presencial, derecho internacional, derechos humanos y apertura de empresas en Dubái.',
      image: portraitUrl,
      logo: absoluteUrl('/icon-512.png', site),
      telephone: PHONE.e164,
      email: EMAIL.address,
      address: {
        '@type': 'PostalAddress',
        streetAddress: OFFICE.streetAddress,
        postalCode: OFFICE.postalCode,
        addressLocality: OFFICE.locality,
        addressRegion: OFFICE.region,
        addressCountry: OFFICE.country,
      },
      hasMap: OFFICE.mapsUrl,
      priceRange: `${formatAmount(minAmount)} € – ${formatAmount(maxAmount)} €`,
      sameAs,
      founder: { '@id': `${home}#denisse` },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios',
        itemListElement: [
          {
            '@type': 'OfferCatalog',
            name: immigration.title,
            itemListElement: immigration.services.map((s) => serviceOffer(s.name)),
          },
          { '@type': 'OfferCatalog', name: 'Asesorías y Programa Autogestiona', itemListElement: offers },
          { '@type': 'OfferCatalog', name: 'Apertura de empresas en Dubái', itemListElement: [serviceOffer(dubai.name)] },
        ],
      },
    },
    {
      '@type': 'Person',
      '@id': `${home}#denisse`,
      name: SITE.legalName,
      alternateName: SITE.name,
      jobTitle: SITE.role,
      worksFor: { '@id': `${home}#despacho` },
      url: absoluteUrl('/conoceme/', site),
      image: portraitUrl,
      sameAs,
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Universidad TecMilenio' },
        { '@type': 'CollegeOrUniversity', name: 'California Western School of Law' },
        { '@type': 'CollegeOrUniversity', name: 'NYU School of Professional Studies' },
        { '@type': 'CollegeOrUniversity', name: 'ISDE' },
        { '@type': 'CollegeOrUniversity', name: 'UAX' },
      ],
    },
    ...(noindex
      ? []
      : [
          {
            '@type': 'WebPage',
            '@id': `${pageUrl}#webpage`,
            url: pageUrl,
            name: title,
            description,
            inLanguage: 'es',
            isPartOf: { '@id': `${home}#website` },
            about: { '@id': `${home}#despacho` },
          },
        ]),
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
