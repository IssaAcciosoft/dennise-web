---
import { NAV, FOOTER_EXTRA, LEGAL_NAV, SITE, PHONE, TEL_LINK, WA_TEXT, waLink, EMAIL, OFFICE } from '~/data/site';
import { url, normalizePath } from '~/lib/url';
import logo from '~/assets/logo/dg-logo.svg?url';
// Variante clara del logo (mismos trazos, colores de la cabecera oscura) para el pie oscuro de EV.
import logoDark from '~/assets/logo/dg-logo-dark.svg?url';
import SocialLinks from '../ui/SocialLinks.astro';
import Photo from '../ui/Photo.astro';
// Logo principal de Empoderando Voces en la franja del pie (la cliente pidió quitar el de las siluetas).
import evLogo from '~/assets/img/ev/logo-ev-principal.png';

interface Props {
  /** Páginas cortas (404, /gracias/): el logo del pie se ve al cargar y puede ser el LCP. */
  logoEager?: boolean;
}
const { logoEager = false } = Astro.props;
const year = new Date().getFullYear();
const current = normalizePath(Astro.url.pathname);
const here = (path: string) => (current === path ? 'page' : undefined);
// En /empoderando-voces/ la página ya cierra con el logo de EV y el lema «Escuchar. Conectar.
// Actuar.»: el pie no repite ni el lema ni la franja de EV (que enlazaría a la propia página).
// Allí el pie es oscuro (tokens --ev-*), continuación de la página, sin corte a lavanda.
const onEv = current === '/empoderando-voces/';
---

<footer class="site-footer" data-wa-hide data-tone={onEv ? 'dark' : undefined}>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href={url('/')}>
        <img
          src={onEv ? logoDark : logo}
          width="656"
          height="494"
          alt="Denisse González — volver al inicio"
          loading={logoEager ? 'eager' : 'lazy'}
          fetchpriority={logoEager ? 'high' : undefined}
          decoding="async"
        />
      </a>
      {!onEv && <p class="footer-motto">{SITE.motto}</p>}
      {
        !onEv && (
          <a class="footer-ev" href={url('/empoderando-voces/')}>
            <span class="footer-ev-logo">
              <Photo src={evLogo} alt="" widths={[120, 180]} sizes="60px" />
            </span>
            <span class="footer-ev-text">
              <span class="footer-ev-name">Empoderando Voces</span>
              <span class="footer-ev-sub">Afirmando la Dignidad</span>
            </span>
          </a>
        )
      }
    </div>

    <nav class="footer-nav" aria-label="Pie de página">
      <h2 class="footer-title">Navegación</h2>
      <ul role="list">
        <li><a href={url('/')} aria-current={here('/')}>Inicio</a></li>
        {NAV.map((item) => <li><a href={url(item.path)} aria-current={here(item.path)}>{item.path === '/apertura-de-empresas/' ? 'Apertura de empresas' : item.label}</a></li>)}
      </ul>
      <ul class="footer-extra" role="list">
        {FOOTER_EXTRA.map((item) => <li><a href={url(item.path)} aria-current={here(item.path)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-contact">
      <h2 class="footer-title">Contacto</h2>
      <ul class="footer-contact-list" role="list">
        <li><a href={waLink(WA_TEXT.general)} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={TEL_LINK}>{PHONE.display}</a></li>
        <li><a class="footer-email" href={EMAIL.href}>{EMAIL.user}<wbr />@{EMAIL.domain}</a></li>
        <li class="footer-contact-note">Asesorías online y presenciales</li>
      </ul>
      <address class="footer-address">
        <span class="footer-address-name">{OFFICE.name}</span>
        <span>{OFFICE.street} <span class="nowrap">({OFFICE.neighborhood})</span></span>
        <span>{OFFICE.postalCode} {OFFICE.locality}</span>
        <a href={OFFICE.mapsUrl} target="_blank" rel="noopener">Cómo llegar<span class="visually-hidden"> (Google Maps, se abre en una pestaña nueva)</span></a>
      </address>
      <SocialLinks variant="icons" tone={onEv ? 'dark' : 'light'} class="footer-social" />
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {SITE.firm}&nbsp;· {SITE.name}</p>
    <nav class="footer-legal-nav" aria-label="Legal">
      <ul class="footer-legal" role="list">
        {LEGAL_NAV.map((item) => <li><a href={url(item.path)} aria-current={here(item.path)}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: calc(2rem + env(safe-area-inset-bottom));
    background: var(--c-lavender-200);
    color: var(--c-ink-soft);
    font-size: var(--fs-small);
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-logo { display: inline-block; }
  .footer-logo img { width: 180px; }
  .footer-motto {
    margin-top: 1.25rem;
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--c-plum);
  }
  /* Franja de Empoderando Voces (logo principal sobre su fondo blanco) */
  .footer-ev {
    display: inline-flex;
    align-items: center;
    gap: .9rem;
    margin-top: 1.5rem;
    padding: .5rem 1.1rem .5rem .5rem;
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-radius: 14px;
    transition: border-color var(--dur-fast) var(--ease-hover), transform var(--dur-press) var(--ease-out);
  }
  .site-footer a.footer-ev { text-decoration: none; }
  .site-footer a.footer-ev:active { transform: scale(.99); }
  .footer-ev-name { transition: color var(--dur-fast) var(--ease-hover); }
  .footer-ev-logo { width: 60px; flex: none; }
  .footer-ev-logo :global(img) { display: block; width: 100%; height: auto; }
  .footer-ev-text { display: grid; gap: .1rem; line-height: 1.3; }
  .footer-ev-name { color: var(--c-ink); font-family: var(--ff-serif); font-size: 1.15rem; font-weight: 600; }
  .footer-ev-sub { color: var(--c-muted); font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  @media (hover: hover) and (pointer: fine) {
    .site-footer a.footer-ev:hover { text-decoration: none; border-color: var(--c-line-strong); }
    .site-footer a.footer-ev:hover .footer-ev-name { color: var(--c-plum); }
  }
  .footer-title {
    margin-bottom: 1rem;
    color: var(--c-ink);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .footer-nav ul,
  .footer-contact-list { display: grid; gap: .2rem; }
  .footer-extra { margin-top: .6rem; padding-top: .6rem; border-top: 1px solid var(--c-line); }
  /* Subrayado presente pero transparente: en hover, color y subrayado se funden a la vez. */
  .site-footer a {
    color: var(--c-ink-soft);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: .2em;
    transition: color var(--dur-fast) var(--ease-hover), text-decoration-color var(--dur-fast) var(--ease-hover);
  }
  .footer-nav a,
  .footer-contact-list a,
  .footer-contact-note { display: inline-block; padding-block: .3rem; }
  /* Móvil: enlaces apilados con objetivo táctil de 44 px (MOBILE-17). */
  @media (max-width: 699.98px) {
    .footer-nav a,
    .footer-contact-list a,
    .footer-address a,
    .footer-legal a { display: inline-flex; align-items: center; min-height: 44px; padding-block: 0; }
    .footer-nav ul,
    .footer-contact-list { gap: 0; }
    .footer-legal { gap: 0 1.5rem; }
  }
  /* Texto informativo, no enlace: se distingue de WhatsApp, teléfono y email. */
  .footer-contact-note { color: var(--c-muted); font-style: italic; }
  @media (hover: hover) and (pointer: fine) {
    .site-footer a:hover { color: var(--c-plum); text-decoration-color: currentColor; }
  }
  .footer-address {
    display: grid;
    gap: .1rem;
    margin-top: 1.1rem;
    font-style: normal;
    line-height: 1.5;
  }
  .footer-address-name { color: var(--c-ink); font-weight: 600; }
  .footer-address a { justify-self: start; padding-block: .3rem; text-decoration: underline; text-decoration-color: var(--c-line-strong); }
  .footer-contact :global(.footer-social) { margin-top: 1.25rem; }

  .footer-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: .75rem 2rem;
    padding-top: 1.5rem;
    font-size: .875rem;
  }
  .footer-bottom::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--c-line);
  }
  .footer-legal { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .site-footer a[aria-current="page"] { color: var(--c-plum); font-weight: 600; }
  .footer-legal a { display: inline-block; padding-block: .25rem; text-decoration: underline; text-decoration-color: var(--c-line-strong); }

  /* ---------- Pie oscuro (Empoderando Voces) ---------- */
  .site-footer[data-tone="dark"] {
    --c-line: var(--ev-line);
    --c-line-strong: rgba(221, 181, 108, .45);
    background: linear-gradient(180deg, var(--ev-bg), var(--ev-bg-2));
    color: var(--ev-muted);
    border-top: 1px solid var(--ev-line);
  }
  .site-footer[data-tone="dark"] :is(.footer-nav, .footer-contact-list, .footer-address, .footer-legal) a { color: var(--ev-text); }
  .site-footer[data-tone="dark"] .footer-title { color: var(--ev-gold); }
  .site-footer[data-tone="dark"] .footer-address-name { color: var(--ev-text); }
  .site-footer[data-tone="dark"] .footer-contact-note { color: var(--ev-faint); }
  .site-footer[data-tone="dark"] :is(.footer-nav, .footer-legal) a[aria-current="page"] { color: var(--ev-gold); }
  @media (hover: hover) and (pointer: fine) {
    .site-footer[data-tone="dark"] :is(.footer-nav, .footer-contact-list, .footer-address, .footer-legal) a:hover { color: var(--ev-gold-2); }
  }

  @media (min-width: 700px) {
    .footer-grid { grid-template-columns: 1.3fr 1fr 1fr; }
  }
  /* El WhatsApp flotante se oculta sobre el pie ([data-wa-hide]): no hace falta reservarle
     sitio. Sin JavaScript (siempre visible), WhatsAppFloat.astro añade ese espacio en <noscript>. */
  @media (max-width: 699.98px) {
    .site-footer { padding-bottom: calc(2.5rem + env(safe-area-inset-bottom)); }
  }
</style>
