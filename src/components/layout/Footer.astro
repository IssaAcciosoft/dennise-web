---
import { NAV, LEGAL_NAV, SITE, PHONE, TEL_LINK, WA_TEXT, waLink, EMAIL, OFFICE } from '~/data/site';
import { url, normalizePath } from '~/lib/url';
import logo from '~/assets/logo/dg-logo.svg?url';
import SocialLinks from '../ui/SocialLinks.astro';

interface Props {
  /** Páginas cortas (404, /gracias/): el logo del pie se ve al cargar y puede ser el LCP. */
  logoEager?: boolean;
}
const { logoEager = false } = Astro.props;
const year = new Date().getFullYear();
const current = normalizePath(Astro.url.pathname);
const here = (path: string) => (current === path ? 'page' : undefined);
---

<footer class="site-footer" data-wa-hide>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href={url('/')}>
        <img
          src={logo}
          width="656"
          height="494"
          alt="Denisse González — volver al inicio"
          loading={logoEager ? 'eager' : 'lazy'}
          fetchpriority={logoEager ? 'high' : undefined}
          decoding="async"
        />
      </a>
      <p class="footer-motto">{SITE.motto}</p>
    </div>

    <nav class="footer-nav" aria-label="Pie de página">
      <h2 class="footer-title">Navegación</h2>
      <ul role="list">
        <li><a href={url('/')} aria-current={here('/')}>Inicio</a></li>
        {NAV.map((item) => <li><a href={url(item.path)} aria-current={here(item.path)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-contact">
      <h2 class="footer-title">Contacto</h2>
      <ul class="footer-contact-list" role="list">
        <li><a href={waLink(WA_TEXT.general)} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={TEL_LINK}>{PHONE.display}</a></li>
        <li><a class="footer-email" href={EMAIL.href}>{EMAIL.user}<wbr />@{EMAIL.domain}</a></li>
        <li>Asesorías online y presenciales</li>
      </ul>
      <address class="footer-address">
        <span class="footer-address-name">{OFFICE.name}</span>
        <span>{OFFICE.street} <span class="nowrap">({OFFICE.neighborhood})</span></span>
        <span>{OFFICE.postalCode} {OFFICE.locality}</span>
        <a href={OFFICE.mapsUrl} target="_blank" rel="noopener">Cómo llegar<span class="visually-hidden"> (Google Maps, se abre en una pestaña nueva)</span></a>
      </address>
      <SocialLinks variant="icons" class="footer-social" />
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {SITE.firm}&nbsp;· {SITE.name}</p>
    <nav class="footer-legal-nav" aria-label="Legal">
      <ul class="footer-legal" role="list">
        {LEGAL_NAV.map((item) => <li><a href={url(item.path)} aria-current={here(item.path)}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: calc(2rem + env(safe-area-inset-bottom));
    background: var(--c-lavender-200);
    color: var(--c-ink-soft);
    font-size: var(--fs-small);
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-logo { display: inline-block; }
  .footer-logo img { width: 180px; }
  .footer-motto {
    margin-top: 1.25rem;
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--c-plum);
  }
  .footer-title {
    margin-bottom: 1rem;
    color: var(--c-ink);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .footer-nav ul,
  .footer-contact-list { display: grid; gap: .2rem; }
  .site-footer a { color: var(--c-ink-soft); text-decoration: none; }
  .footer-nav a,
  .footer-contact-list a { display: inline-block; padding-block: .3rem; }
  @media (hover: hover) {
    .site-footer a:hover { color: var(--c-plum); text-decoration: underline; }
  }
  .footer-address {
    display: grid;
    gap: .1rem;
    margin-top: 1.1rem;
    font-style: normal;
    line-height: 1.5;
  }
  .footer-address-name { color: var(--c-ink); font-weight: 600; }
  .footer-address a { justify-self: start; padding-block: .3rem; text-decoration: underline; text-decoration-color: var(--c-line-strong); }
  .footer-contact :global(.footer-social) { margin-top: 1.25rem; }

  .footer-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .75rem 2rem;
    padding-top: 1.5rem;
    font-size: .875rem;
  }
  .footer-bottom::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--c-line);
  }
  .footer-legal { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .site-footer a[aria-current="page"] { color: var(--c-plum); font-weight: 600; }
  .footer-legal a { display: inline-block; padding-block: .25rem; text-decoration: underline; text-decoration-color: var(--c-line-strong); }

  @media (min-width: 700px) {
    .footer-grid { grid-template-columns: 1.3fr 1fr 1fr; }
  }
  @media (max-width: 699.98px) {
    /* Espacio para el botón flotante de WhatsApp */
    .site-footer { padding-bottom: calc(6rem + env(safe-area-inset-bottom)); }
  }
</style>
