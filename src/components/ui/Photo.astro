---
/**
 * Fotografía optimizada con astro:assets: <picture> AVIF + WebP + JPG de respaldo,
 * srcset por anchos, width/height (sin CLS), lazy por defecto.
 * `priority`: solo para la imagen principal visible al cargar (eager + fetchpriority=high).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Anchos a generar (px). Por defecto, hasta el ancho original. */
  widths?: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  /** object-position, p. ej. "50% 60%". */
  position?: string;
}

const { src, alt, sizes, priority = false, class: className, pictureClass, position } = Astro.props;
const max = src.width;
const widths = (Astro.props.widths ?? [360, 540, 720, 960, 1200]).filter((w) => w <= max);
if (!widths.includes(max) && widths[widths.length - 1] < max && max <= 1600) widths.push(max);
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  priority={priority}
  loading={priority ? undefined : 'lazy'}
  decoding="async"
  class={className}
  pictureAttributes={pictureClass ? { class: pictureClass } : {}}
  style={position ? `object-position:${position}` : undefined}
/>
