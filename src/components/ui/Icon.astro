}
const { name, class: className, label } = Astro.props;
const body = ICONS[name];
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
