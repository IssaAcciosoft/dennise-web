---
/**
 * Programa Autogestiona: trámites, planes, «¿Cómo funciona?» y «Todos los planes incluyen»
 * (servicios.json). docs/integracion-acciogest.md §3:
 * - «Contratar Plan X» con el ID del plan configurado (PLANES en src/config/acciogest.ts) →
 *   página de pago de AccioGest {API}/form-builder/public/{FORM_ID}/page en pestaña nueva.
 * - Sin ID (valor de ejemplo) → abre el diálogo «Solicitar información» con el plan
 *   preseleccionado (data-service-request); sin JavaScript, WhatsApp.
 */
import { autogestiona as program, formatAmount, CATALOG } from '~/lib/services';
import { WA_TEXT, waLink } from '~/data/site';
import { planPageUrl, type PlanKey } from '~/config/acciogest';
import { url } from '~/lib/url';
import Icon from '../ui/Icon.astro';

const planMessage = (name: string, amount: number) =>
  `Hola Denisse, me interesa el ${name} (${formatAmount(amount)} €, ${CATALOG.tax_label}) del ${program.name}. Mi trámite es: `;

/*
 * «¿Cómo funciona?»: SOLO hechos conocidos (pago previo + lo que incluyen los planes, en el
 * orden lógico del trámite). Sin plazos.
 * PENDIENTE DE CONFIRMAR (cliente / AccioGest): el proceso exacto tras la compra (quién
 * contacta, cómo se agenda la asesoría inicial, cómo se envía la documentación).
 */
const steps = [
  'Eliges tu plan y realizas el pago de forma segura',
  'Asesoría inicial con un experto en extranjería',
  'Cumplimentación de los formularios',
  'Presentación del expediente',
  'Acceso a las notificaciones de extranjería y resolución de dudas sobre los requerimientos',
];
---

<div class="autogestiona" id="autogestiona">
  <div class="autogestiona-head">
    <div data-reveal>
      <p class="eyebrow">Planes&nbsp;· {CATALOG.tax_label}</p>
      <h2 class="block-title" id="autogestiona-title">{program.name}</h2>
    </div>
    <div class="tramites" data-reveal data-tour="tramites">
      <h3 class="tramites-title">{program.procedures_title}:</h3>
      <ul class="chip-list" role="list">
        {program.procedures.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>

  <ul class="plan-grid" role="list" data-tour="planes">
    {
      program.plans.map((plan) => (
        <li class:list={['plan-card', { 'plan-card--featured': plan.featured }]} data-plan-key={plan.form_key} data-reveal data-spotlight={plan.featured ? 'dark' : ''}>
          <h3 class="plan-name">{plan.name}</h3>
          <p class="plan-price">
            <span class="price">{formatAmount(plan.amount)}</span>
            <span class="currency">€</span>
          </p>
          <p class="plan-vat">{CATALOG.tax_label}</p>
          {(() => {
            const payUrl = planPageUrl(plan.form_key as PlanKey);
            const cls = ['btn', 'btn--block', plan.featured ? 'btn--light' : 'btn--outline'];
            return payUrl ? (
              <a class:list={cls} href={payUrl} target="_blank" rel="noopener" data-plan-cta={plan.form_key} data-lead-value={plan.lead_value}>
                <span>Contratar {plan.name}</span>
                <Icon name="external" />
                <span class="visually-hidden"> (pago seguro en AccioGest, se abre en una pestaña nueva)</span>
              </a>
            ) : (
              <a
                class:list={cls}
                href={waLink(planMessage(plan.name, plan.amount))}
                target="_blank"
                rel="noopener"
                data-plan-cta={plan.form_key}
                data-lead-value={plan.lead_value}
                data-service-request={plan.lead_value}
              >
                <span>Contratar {plan.name}</span>
              </a>
            );
          })()}
        </li>
      ))
    }
  </ul>

  <p class="plan-terms" data-reveal>
    Pago seguro con tarjeta. Al contratar aceptas las{' '}
    <a href={url('/condiciones-contratacion/')}>condiciones de contratación</a>.
  </p>

  <div class="plan-steps" data-reveal data-tour="como-funciona">
    <h3 class="plan-steps-title">¿Cómo funciona?</h3>
    <ol class="steps" role="list">
      {
        steps.map((step, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="step-text">{step}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="plan-includes" data-reveal data-tour="incluye">
    <h3 class="plan-includes-title">{program.includes_title}</h3>
    <ul class="check-list" role="list">
      {
        program.includes.map((item) => (
          <li>
            <Icon name="check" />
            {item}
          </li>
        ))
      }
    </ul>
    <a class="btn btn--link plan-includes-cta" href={waLink(WA_TEXT.autogestionaDudas)} target="_blank" rel="noopener">
      <span>¿Dudas sobre qué plan elegir? Escríbeme</span>
      <Icon name="arrow" />
    </a>
  </div>
</div>

<style>
  .autogestiona {
    padding: clamp(1.5rem, .5rem + 4vw, 4.5rem) clamp(1rem, .25rem + 4vw, 4.5rem);
    background:
      radial-gradient(40rem 24rem at 100% 0%, rgba(213, 193, 220, .55), transparent 70%),
      var(--c-lavender);
    border-radius: clamp(20px, 3vw, 36px);
  }
  .autogestiona-head { display: grid; gap: 1.75rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .autogestiona-head .eyebrow { margin-bottom: .75rem; }
  .block-title {
    font-family: var(--ff-serif);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
  }
  .tramites-title {
    margin-bottom: 1rem;
    color: var(--c-ink);
    font-size: .82rem;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  @media (min-width: 960px) {
    .autogestiona-head { grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr); gap: 4rem; align-items: start; }
  }

  .plan-grid { display: grid; gap: 1.25rem; align-items: stretch; }
  .plan-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 1.25rem + 1.2vw, 2.4rem);
    background: var(--c-white);
    border: 1px solid rgba(110, 29, 122, .14);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
  }
  .plan-name {
    color: var(--c-plum);
    font-size: .82rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .plan-price { margin-top: .75rem; color: var(--c-ink); line-height: 1; }
  .plan-price .price { font-size: clamp(3.2rem, 2.6rem + 2vw, 4.4rem); }
  .plan-price .currency { font-size: 1.8rem; }
  .plan-vat {
    margin-top: .6rem;
    margin-bottom: 1.75rem;
    color: var(--c-muted);
    font-size: .82rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .plan-card .btn { margin-top: auto; white-space: nowrap; }

  .plan-card--featured {
    --focus: #fff; /* anillo de foco visible sobre el ciruela (v1: A2) */
    position: relative;
    background:
      radial-gradient(26rem 16rem at 100% 0%, rgba(165, 80, 180, .55), transparent 70%),
      linear-gradient(160deg, var(--c-plum) 0%, var(--c-plum-800) 100%);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 30px 60px -28px rgba(68, 16, 77, .8);
  }
  .plan-card--featured .plan-name { color: var(--c-lavender-300); }
  .plan-card--featured .plan-price { color: #fff; }
  .plan-card--featured .plan-vat { color: rgba(243, 237, 245, .8); }
  .plan-card--featured::after {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(243, 237, 245, .18);
    border-radius: calc(var(--radius-l) - 8px);
    pointer-events: none;
  }

  @media (min-width: 560px) and (max-width: 899.98px) {
    .plan-card { display: grid; grid-template-columns: 1fr auto; column-gap: 1.5rem; align-items: center; }
    .plan-card .btn { grid-column: 2; grid-row: 1 / span 3; width: auto; margin: 0; }
    .plan-vat { margin-bottom: 0; }
  }
  @media (min-width: 900px) {
    .plan-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* Plan destacado más alto sin transform (v1: V5) */
  @media (min-width: 1024px) {
    .plan-grid { padding-block: 1rem; }
    .plan-card--featured { margin-block: -1rem; }
  }

  .plan-card .btn :global(.icon) { width: 1rem; height: 1rem; }

  .plan-terms {
    margin-top: 1.5rem;
    color: var(--c-ink-soft);
    font-size: var(--fs-small);
    text-align: center;
    text-wrap: balance;
  }

  .plan-steps {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.25rem, .75rem + 2vw, 2.5rem);
    background: var(--c-white);
    border: 1px solid rgba(110, 29, 122, .14);
    border-radius: var(--radius-l);
  }
  .plan-steps-title {
    margin-bottom: 1.5rem;
    font-family: var(--ff-serif);
    font-size: var(--fs-h4);
    font-weight: 600;
  }
  .steps { display: grid; gap: 0; counter-reset: none; }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    align-items: start;
    align-content: start;
    gap: 1rem;
    padding-bottom: 1.4rem;
  }
  .step:last-child { padding-bottom: 0; }
  /* Línea que une los pasos (vertical en móvil) */
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(1.375rem - .5px);
    top: 2.9rem;
    bottom: .2rem;
    width: 1px;
    background: var(--c-line-strong);
  }
  .step-num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--c-lavender);
    color: var(--c-plum);
    font-family: var(--ff-serif);
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .step:first-child .step-num { background: var(--c-plum); color: #fff; }
  .step-text { padding-top: .55rem; color: var(--c-ink); font-weight: 400; line-height: 1.45; text-wrap: pretty; }
  @media (min-width: 1000px) {
    .steps { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; }
    .step { grid-template-columns: 1fr; gap: .9rem; padding-bottom: 0; }
    .step:not(:last-child)::before {
      left: 3.5rem;
      right: -1rem;
      top: 1.375rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .step-text { padding-top: 0; }
  }

  .plan-includes {
    margin-top: 1.5rem;
    padding: clamp(1.25rem, .75rem + 2vw, 2.5rem);
    background: rgba(255, 255, 255, .7);
    border: 1px solid rgba(110, 29, 122, .14);
    border-radius: var(--radius-l);
  }
  .plan-includes-title {
    margin-bottom: 1.25rem;
    font-family: var(--ff-serif);
    font-size: var(--fs-h4);
    font-weight: 600;
  }
  .plan-includes-cta { margin-top: 1.5rem; justify-content: flex-start; text-align: left; }
  @media (min-width: 700px) {
    .plan-includes :global(.check-list) { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1100px) {
    .plan-includes :global(.check-list) { grid-template-columns: repeat(3, 1fr); }
  }
</style>
