---
/**
 * «Gestoría y otros trámites» (/servicios/, tras los servicios de extranjería):
 * - Gestión administrativa (docs/cambios-2026-10.md §2.4) y Homologación y equivalencia de
 *   títulos universitarios (§2.12), desde servicios.json → firm_services. Cada uno con
 *   «Solicitar información» (diálogo con el servicio preseleccionado; sin JavaScript, WhatsApp).
 *   PENDIENTE: textos neutros y provisionales hasta que la cliente los amplíe.
 * - Apertura de empresas en España, México y Dubái (§2.3) → /apertura-de-empresas/.
 * - Foto «Denisse atendiendo a una pareja en el despacho» (§6).
 */
import { firmServices, companies } from '~/lib/services';
import { waLink } from '~/data/site';
import { url } from '~/lib/url';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import atendiendo from '~/assets/img/despacho-atendiendo-clientes.webp';

const askText = (leadValue: string) => `Hola Denisse, me gustaría recibir información sobre: ${leadValue}.`;
const countries = companies.countries.map((c) => c.name);
---

<section class="section section--lavender firm" id="gestoria" aria-labelledby="gestoria-title">
  <div class="container firm-grid">
    <div class="firm-head">
      <p class="eyebrow" data-reveal>{firmServices.eyebrow}</p>
      <h2 class="section-title firm-title" id="gestoria-title" data-reveal>{firmServices.title}</h2>
    </div>

    <figure class="firm-media" data-reveal="photo">
      <Photo
        src={atendiendo}
        alt="Denisse González atiende a una pareja en su despacho de DG Gestores y Abogados y revisa documentos con ellos"
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 960px) 46vw, calc(100vw - 2 * var(--gutter))"
        position="38% 50%"
      />
    </figure>

    <ul class="firm-list" role="list" data-tour="gestoria">
      {
        firmServices.services.map((s) => (
          <li class="firm-card" data-service-id={s.id} data-reveal data-spotlight>
            <h3 class="firm-name">{s.name}</h3>
            <p class="firm-desc">{s.description}</p>
            <a class="btn btn--link firm-ask" href={waLink(askText(s.lead_value))} target="_blank" rel="noopener" data-service-request={s.lead_value}>
              <span>
                Solicitar información<span class="visually-hidden">{` sobre ${s.name.toLowerCase()}`}</span>
              </span>
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
      <li class="firm-card firm-card--link" data-reveal>
        <p class="firm-kicker">{countries.join(' · ')}</p>
        <h3 class="firm-name">
          <a href={url(companies.path)}>{companies.name}</a>
        </h3>
        <p class="firm-desc">Te ayudamos a crear tu negocio con estructura legal sólida.</p>
        <span class="firm-go" aria-hidden="true">
          <span>Ver apertura de empresas</span>
          <Icon name="arrow" />
        </span>
      </li>
    </ul>
  </div>
</section>

<style>
  .firm-grid {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4.5rem);
  }
  .firm-title { max-width: 9em; }
  .firm-media {
    position: relative;
    isolation: isolate;
    margin-right: 1rem;
  }
  .firm-media::before {
    content: "";
    position: absolute;
    inset: 1.25rem -1rem -1rem 1.25rem;
    background: var(--c-lavender-200);
    border-radius: var(--radius-l);
    z-index: -1;
  }
  .firm-media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-l);
  }
  .firm-list { display: grid; gap: 1rem; align-content: start; }
  .firm-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: .6rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    transition: border-color var(--dur) var(--ease-hover), box-shadow var(--dur) var(--ease-out);
  }
  .firm-name {
    font-family: var(--ff-serif);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.12;
    text-wrap: balance;
  }
  .firm-desc { color: var(--c-ink-soft); font-size: var(--fs-small); line-height: 1.65; text-wrap: pretty; }
  .firm-ask { align-self: flex-start; font-size: .95rem; }

  .firm-card--link {
    --focus: #fff;
    color: var(--ev-muted);
    background:
      radial-gradient(30rem 16rem at 100% 0%, rgba(165, 80, 180, .4), transparent 70%),
      linear-gradient(160deg, #3A0E42 0%, var(--c-plum-800) 100%);
    border-color: transparent;
  }
  .firm-card--link:active { transform: scale(.99); }
  .firm-card--link .firm-desc { color: var(--ev-muted); }
  .firm-kicker {
    color: var(--ev-gold);
    font-size: .74rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .firm-card--link .firm-name a { color: #fff; text-decoration: none; }
  .firm-card--link .firm-name a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .firm-card--link .firm-name a:focus-visible { outline: none; }
  .firm-card--link:has(a:focus-visible) { outline: 3px solid var(--ev-gold); outline-offset: 3px; }
  .firm-go {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-top: .25rem;
    color: #fff;
    font-weight: 600;
    font-size: .95rem;
  }
  .firm-go :global(.icon) { color: var(--ev-gold); transition: transform var(--dur) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .firm-card:hover { border-color: var(--c-line-strong); box-shadow: var(--shadow-s); }
    .firm-card--link:hover { border-color: transparent; box-shadow: var(--shadow); }
    .firm-card--link:hover .firm-go :global(.icon) { transform: translateX(3px); }
  }

  @media (min-width: 960px) {
    .firm-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "media head" "media list";
      align-items: start;
    }
    .firm-head { grid-area: head; }
    .firm-title { max-width: none; }
    .firm-media { grid-area: media; position: sticky; top: calc(var(--header-h, 80px) + 1.5rem); }
    .firm-list { grid-area: list; }
    .firm-media :global(img) { aspect-ratio: 4 / 5; }
  }
</style>
