---
/**
 * Preguntas frecuentes de /servicios/ (web anterior, docs/web-anterior.md §5): las dos de España
 * y la de Dubái, todas con <details>/<summary>. La de Dubái lleva aquí solo la primera frase de
 * su respuesta y un enlace a /apertura-de-empresas/#preguntas (allí está completa); por eso no
 * entra en el FAQPage de JSON-LD de esta página (lo pone la página, solo con FAQ_SPAIN).
 * Visita guiada: último paso (data-tour="preguntas").
 */
import { FAQ_SPAIN, FAQ_DUBAI } from '~/data/faq';
import { url } from '~/lib/url';
import Faq from '../ui/Faq.astro';

const dubai = FAQ_DUBAI[0];
const items = [
  ...FAQ_SPAIN,
  ...(dubai
    ? [
        {
          ...dubai,
          // Las dos primeras frases de la respuesta de la cliente («Sí. …»); la completa, en Apertura.
          answer: dubai.answer.split(/(?<=\.)\s/).slice(0, 2).join(' '),
          link: { href: url('/apertura-de-empresas/#preguntas'), label: 'Ver apertura de empresas' },
        },
      ]
    : []),
];
---

<section class="section section--ivory services-faq" id="preguntas" aria-labelledby="services-faq-title">
  <div class="container faq-layout">
    <div class="faq-head">
      <p class="eyebrow" data-reveal>¿Alguna pregunta?</p>
      <h2 class="section-title" id="services-faq-title" data-reveal>Preguntas frecuentes</h2>
      <p class="lead" data-reveal>Resolvemos las dudas más habituales.</p>
    </div>
    <div data-reveal>
      <div data-tour="preguntas"><Faq items={items} /></div>
    </div>
  </div>
</section>

<style>
  .faq-layout { display: grid; gap: 2rem clamp(3rem, 6vw, 6rem); }
  .faq-head .section-title { max-width: 8em; margin-bottom: 1rem; }
  .faq-head .lead { max-width: 24rem; }
  @media (min-width: 960px) {
    .faq-layout { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
  }
</style>
