---
/**
 * Preguntas frecuentes de /servicios/ (web anterior, docs/web-anterior.md §5): las dos de España
 * con <details>/<summary> y la de Dubái como enlace a /dubai/#preguntas (allí está su respuesta).
 * El FAQPage de JSON-LD lo pone la página (solo con las preguntas que se responden aquí).
 * Visita guiada: último paso (data-tour="preguntas").
 */
import { FAQ_SPAIN, FAQ_DUBAI } from '~/data/faq';
import { url } from '~/lib/url';
import Faq from '../ui/Faq.astro';
import Icon from '../ui/Icon.astro';

const dubaiQuestion = FAQ_DUBAI[0]?.question ?? '¿Puedo abrir una empresa en Dubái desde el extranjero?';
---

<section class="section section--ivory services-faq" id="preguntas" aria-labelledby="services-faq-title">
  <div class="container faq-layout">
    <div class="faq-head">
      <p class="eyebrow" data-reveal>¿Alguna pregunta?</p>
      <h2 class="section-title" id="services-faq-title" data-reveal>Preguntas frecuentes</h2>
      <p class="lead" data-reveal>Estas son algunas de las preguntas comunes.</p>
    </div>
    <div data-reveal>
      <div data-tour="preguntas"><Faq items={FAQ_SPAIN} /></div>
      <a class="faq-dubai" href={url('/dubai/#preguntas')}>
        <span class="faq-dubai-q">{dubaiQuestion}</span>
        <span class="faq-dubai-go">
          <span>Respuesta en «Abre tu empresa en Dubái»</span>
          <Icon name="arrow" />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-layout { display: grid; gap: 2rem clamp(3rem, 6vw, 6rem); }
  .faq-head .section-title { max-width: 8em; margin-bottom: 1rem; }
  .faq-head .lead { max-width: 24rem; }
  @media (min-width: 960px) {
    .faq-layout { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
  }
  .faq-dubai {
    display: grid;
    gap: .4rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-ink);
    text-decoration: none;
  }
  .faq-dubai-q {
    font-family: var(--ff-serif);
    font-size: clamp(1.3rem, 1.15rem + .7vw, 1.65rem);
    font-weight: 600;
    line-height: 1.22;
    text-wrap: pretty;
  }
  .faq-dubai-go {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: var(--c-plum);
    font-size: .95rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(110, 29, 122, .35);
    text-underline-offset: .3em;
  }
  .faq-dubai-go :global(.icon) { transition: transform var(--dur) var(--ease-out); }
  .faq-dubai:focus-visible { outline-offset: 4px; border-radius: 6px; }
  @media (hover: hover) and (pointer: fine) {
    .faq-dubai:hover { color: var(--c-plum); }
    .faq-dubai:hover .faq-dubai-go { text-decoration-color: currentColor; }
    .faq-dubai:hover .faq-dubai-go :global(.icon) { transform: translateX(3px); }
  }
</style>
