---
/**
 * «Servicios de extranjería en España» (/servicios/, antes de los precios). Textos de la web
 * anterior (docs/web-anterior.md §5 y §6) desde src/data/servicios.json → immigration.
 * - Cada servicio: «Solicitar información» abre el diálogo de solicitud (ServiceRequestDialog)
 *   con el servicio preseleccionado (data-service-request = lead_value); sin JavaScript, WhatsApp.
 * - «Nómadas digitales · Emprendedores · Residencias» ya no son una línea de texto («También»):
 *   son tarjetas como las demás (docs/cambios-2026-10.md §2.1), bajo el subtítulo «También». PENDIENTE: sus descripciones son
 *   neutras y provisionales (`pending: true` en servicios.json) hasta que la cliente envíe las suyas.
 * - Visita guiada: data-tour="extranjeria" (src/scripts/tour.ts).
 */
import { immigration } from '~/lib/services';
import { waLink } from '~/data/site';
import Icon from '../ui/Icon.astro';

const askText = (leadValue: string) => `Hola Denisse, me gustaría recibir información sobre: ${leadValue}.`;
const [lead, ...rest] = immigration.intro;
// Los seis servicios principales y, bajo «También», los que eran la línea de la web anterior
// (numeración continua: 01–09). Así 03 «Residencia para emprendedores» y 08 «Emprendedores»
// no se leen como dos tarjetas iguales en la misma rejilla (PENDIENTE: que la cliente confirme
// si son el mismo servicio).
const numbered = immigration.services.map((s, i) => ({ s, n: i + 1 }));
const groups = [
  { title: '', items: numbered.filter(({ s }) => !s.also) },
  { title: immigration.also_title ?? 'También', items: numbered.filter(({ s }) => s.also) },
].filter((g) => g.items.length);
---

<section class="section section--white immigration" id="extranjeria" aria-labelledby="extranjeria-title">
  <div class="container">
    <div class="imm-head" data-tour="extranjeria">
      <div>
        <p class="eyebrow" data-reveal>{immigration.eyebrow}</p>
        <h2 class="section-title imm-title" id="extranjeria-title" data-reveal>{immigration.title}</h2>
      </div>
      <div class="prose imm-intro" data-reveal>
        <p class="prose-lead">{lead}</p>
        {rest.map((p) => <p>{p}</p>)}
      </div>
    </div>

    {
      groups.map((g) => (
        <>
          {g.title && (
            <div class="imm-also-head" data-reveal>
              <h3 class="imm-also-title" id="extranjeria-tambien">{g.title}</h3>
            </div>
          )}
          <ul class:list={['imm-grid', { 'imm-grid--also': g.title }]} role="list" aria-labelledby={g.title ? 'extranjeria-tambien' : undefined}>
            {g.items.map(({ s, n }) => (
              <li class="imm-card" id={s.id} data-service-id={s.id} data-reveal data-spotlight>
                <span class="imm-num" aria-hidden="true">{String(n).padStart(2, '0')}</span>
                {g.title ? <h4 class="imm-name">{s.name}</h4> : <h3 class="imm-name">{s.name}</h3>}
                <p class="imm-desc">{s.description}</p>
                <a class="btn btn--link imm-ask" href={waLink(askText(s.lead_value))} target="_blank" rel="noopener" data-service-request={s.lead_value}>
                  <span>
                    Solicitar información<span class="visually-hidden">{` sobre ${s.name.toLowerCase()}`}</span>
                  </span>
                  <Icon name="arrow" />
                </a>
              </li>
            ))}
          </ul>
        </>
      ))
    }

  </div>
</section>

<style>
  .imm-head {
    display: grid;
    gap: 1.5rem clamp(3rem, 6vw, 5rem);
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .imm-title { max-width: 9em; }
  .imm-intro { max-width: 34em; }
  @media (min-width: 960px) {
    .imm-head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; }
  }

  .imm-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 680px) {
    .imm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1040px) {
    .imm-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  }
  /* 680–1039 px (dos columnas): si la última tarjeta queda sola, ocupa la fila entera. */
  @media (min-width: 680px) and (max-width: 1039.98px) {
    .imm-grid > li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .imm-also-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.5rem;
  }
  .imm-also-head::after { content: ""; flex: 1; height: 1px; background: var(--c-line); }
  .imm-also-title {
    font-family: var(--ff-serif);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.1;
  }
  .imm-card {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.1rem) clamp(1.5rem, 1.2rem + 1vw, 2.1rem) 1.25rem;
    background: var(--c-ivory);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    transition: border-color var(--dur) var(--ease-hover), box-shadow var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .imm-card:hover { border-color: var(--c-line-strong); box-shadow: var(--shadow-s); }
  }
  .imm-num { color: var(--c-plum); font-size: .78rem; font-weight: 600; letter-spacing: .2em; font-variant-numeric: tabular-nums; }
  .imm-name {
    font-family: var(--ff-serif);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.12;
    text-wrap: balance;
  }
  .imm-desc { color: var(--c-ink-soft); font-size: var(--fs-small); line-height: 1.65; text-wrap: pretty; }
  .imm-ask { align-self: flex-start; margin-top: auto; font-size: .95rem; }

</style>
