---
/**
 * Diferencia entre las asesorías del despacho y Autogestión DG (texto de la cliente, 23/11/2026):
 * la diferencia está en el nivel de acompañamiento, comunicación directa y seguimiento.
 * Va en /autogestion-dg/, entre la cabecera y los trámites/planes.
 */
import { autogestion } from '~/lib/services';
import { url } from '~/lib/url';
import Icon from '../ui/Icon.astro';

const cards = [
  {
    id: 'asesoria',
    kicker: 'Asesoría normal',
    title: 'Atención personalizada',
    items: [
      'Contratas directamente un servicio profesional.',
      'Tienes contacto directo con Denisse por WhatsApp.',
      'Puedes plantear preguntas, dudas y consultas durante la gestión.',
      'La comunicación es continua y personalizada.',
      'Recibes acompañamiento y seguimiento durante todo el procedimiento.',
    ],
    summary: 'Un servicio personalizado, con comunicación directa y acompañamiento durante todo el proceso.',
    cta: { href: url('/servicios/'), label: 'Ver servicios' },
  },
  {
    id: 'autogestion',
    kicker: autogestion.name,
    title: 'Servicio por paquetes',
    items: [
      'Contratas un paquete con determinados servicios y un asesoramiento limitado, según el plan que elijas.',
      'Tú aportas la documentación necesaria.',
      'Las consultas se limitan a las asesorías incluidas en tu plan.',
      'No incluye comunicación directa y permanente por WhatsApp.',
      'El acompañamiento se limita a lo que contratas.',
    ],
    summary:
      'Un servicio más automatizado y estructurado: tú haces una parte importante del proceso y recibes el asesoramiento y el seguimiento que incluye tu plan.',
    cta: { href: '#planes', label: 'Ver planes' },
  },
];
---

<section class="section section--lavender ag-compare" aria-labelledby="ag-compare-title">
  <div class="container">
    <div class="ag-compare-head">
      <p class="eyebrow" data-reveal>¿Asesoría o {autogestion.name}?</p>
      <h2 class="section-title" id="ag-compare-title" data-reveal>La diferencia está en el acompañamiento</h2>
      <p class="ag-compare-intro" data-reveal>
        Lo que cambia es el nivel de acompañamiento, la comunicación directa y el seguimiento que recibes.
      </p>
    </div>
    <div class="ag-compare-grid">
      {
        cards.map((c) => (
          <article class:list={['ag-compare-card', `ag-compare-card--${c.id}`]} aria-labelledby={`ag-compare-${c.id}`} data-reveal>
            <p class="ag-compare-kicker">{c.kicker}</p>
            <h3 class="ag-compare-title" id={`ag-compare-${c.id}`}>{c.title}</h3>
            <ul class="ag-compare-list" role="list">
              {c.items.map((it) => <li>{it}</li>)}
            </ul>
            <p class="ag-compare-summary">
              <strong>En resumen:</strong> {c.summary}
            </p>
            <a class="btn btn--link ag-compare-link" href={c.cta.href}>
              <span>{c.cta.label}</span>
              <Icon name="arrow" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ag-compare-head { max-width: 40rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .ag-compare-intro { margin-top: 1rem; color: var(--c-ink-soft); text-wrap: pretty; }
  .ag-compare-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 820px) {
    .ag-compare-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .ag-compare-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.2rem);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
  }
  .ag-compare-card--asesoria { border-top: 3px solid var(--c-plum); }
  .ag-compare-card--autogestion { border-top: 3px solid var(--c-terracotta); }
  .ag-compare-kicker {
    color: var(--c-muted);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .ag-compare-title {
    margin-top: -.5rem;
    color: var(--c-ink);
    font-family: var(--ff-serif);
    font-size: clamp(1.5rem, 1.3rem + .8vw, 1.9rem);
    font-weight: 600;
    line-height: 1.15;
  }
  .ag-compare-list { display: grid; gap: .6rem; padding: 0; margin: 0; list-style: none; }
  .ag-compare-list li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--c-ink-soft);
    text-wrap: pretty;
  }
  .ag-compare-list li::before {
    content: "";
    position: absolute;
    left: .2rem;
    top: .62em;
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--c-plum);
  }
  .ag-compare-card--autogestion .ag-compare-list li::before { background: var(--c-terracotta); }
  .ag-compare-summary {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-ink);
    text-wrap: pretty;
  }
  .ag-compare-link { align-self: flex-start; }
</style>
