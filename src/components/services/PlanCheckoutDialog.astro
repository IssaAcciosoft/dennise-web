---
/**
 * ============================================================================
 *  Diálogo de contratación de un plan de Autogestión DG (cuota mensual)
 * ============================================================================
 *  Handoff de AccioGest del 19-11-2026, §2 y §3. Lo controla src/scripts/plan-checkout.ts.
 *
 *  Disparadores: cualquier elemento con data-plan-checkout="<basico|estandar|premium>" (en
 *  AutogestionPlans.astro, un <a href="https://wa.me/…">: sin JavaScript abre WhatsApp).
 *
 *  Campos (etiquetas EXACTAS de response_data, PLAN_FIELD_LABELS en src/config/acciogest.ts):
 *    Nombre*, Email*, Teléfono*, Consentimiento RGPD*, Desistimiento*
 *  Dos casillas SEPARADAS, ninguna marcada de entrada (se desmarcan cada vez que se abre).
 *  El valor que se envía de cada casilla es su texto plano (src/data/consent.ts): el mismo que
 *  se ve, sin los enlaces.
 *
 *  POST {API}/form-builder/public/{id del plan}/create-checkout-session
 *    { response_data: {…}, utm_source, utm_medium, utm_campaign }   (utm_* en la raíz)
 *  → 200 { url } → página de pago de Stripe. Vuelta: /gracias/?tipo=plan&plan=…&pago=ok&…
 *  Con el ID de ejemplo (modo simulado) no se envía nada y se va a
 *  /gracias/?tipo=plan&plan=…&pago=ok&response_id=mock.
 *
 *  Planes con el precio oculto en AccioGest (amount null) no entran aquí: sin importe no hay
 *  texto de «Desistimiento» que aceptar (AutogestionPlans.astro les deja la solicitud de info).
 *  Tampoco entran los planes sin ID real cuando ya hay alguno configurado (planCheckoutEnabled):
 *  el modo simulado solo existe mientras TODOS los IDs son de ejemplo (WEB-INTEGRACION 12-11 §0).
 *
 *  Antes del botón y en la misma pantalla (WEB-INTEGRACION 12-11 §1, ley de consumo): plan e
 *  importe («Plan Estándar · 315 € al mes (IVA incluido)»), cuándo se cobra, cómo darse de baja
 *  (portal de Stripe solo si PUBLIC_STRIPE_PORTAL_URL es válido, §6.3) y enlace a las condiciones.
 * ============================================================================
 */
import { autogestion, formatAmount, CATALOG } from '~/lib/services';
import {
  PLANES,
  PLAN_FIELD_LABELS,
  PLAN_CHECKOUT_MOCK,
  STRIPE_PORTAL_URL,
  checkoutSessionUrl,
  planCheckoutEnabled,
  type PlanKey,
} from '~/config/acciogest';
import { PLAN_PRIVACY_TEXT, PLAN_LEGAL_NAME, planDesistimientoText, LINK_PHRASES, linkParts } from '~/data/consent';
import { WA_TEXT, waLink, PHONE, TEL_LINK, EMAIL } from '~/data/site';
import { url } from '~/lib/url';
import FormDialog from '../forms/FormDialog.astro';
import Field from '../forms/Field.astro';
import Icon from '../ui/Icon.astro';

const p = 'pc';
const isPlanKey = (k: string): k is PlanKey => k in PLANES;
const plans = autogestion.plans
  .filter((plan) => plan.amount !== null && isPlanKey(plan.form_key) && planCheckoutEnabled(plan.form_key))
  .map((plan) => {
    const key = plan.form_key as PlanKey;
    const amount = plan.amount as number;
    return {
      key,
      name: plan.name,
      // Texto propio de la web: «315 € al mes (IVA incluido)» (AccioGest y Stripe dicen «€/mes»).
      fee: `${formatAmount(amount)} € al mes (${CATALOG.tax_label})`,
      // Nombre legal fijo (no el del catálogo de AccioGest): ver PLAN_LEGAL_NAME.
      desist: planDesistimientoText(PLAN_LEGAL_NAME[key], amount),
      endpoint: checkoutSessionUrl(key),
    };
  });

// Configuración del script (sin define:vars, que lo haría inline).
const config = JSON.stringify({
  plans: Object.fromEntries(plans.map((pl) => [pl.key, { name: pl.name, fee: pl.fee, desist: pl.desist, endpoint: pl.endpoint }])),
  labels: PLAN_FIELD_LABELS,
  privacy: PLAN_PRIVACY_TEXT,
  mock: PLAN_CHECKOUT_MOCK,
  thanks: url('/gracias/'),
  wa: waLink(WA_TEXT.autogestionDudas),
});
const [privBefore, privLink, privAfter] = linkParts(PLAN_PRIVACY_TEXT, LINK_PHRASES.privacy);
---

<FormDialog
  id="plan-dialog"
  tone="brand"
  kicker={autogestion.name}
  title="Contratar un plan"
  intro="Déjanos tus datos y te llevamos a la página de pago seguro con tarjeta (Stripe)."
  dataAttr="data-plan-dialog"
>
  <div class="plan-checkout" data-plan-checkout-root data-config={config}>
    <p class="plan-summary" data-plan-summary hidden>
      <span class="plan-summary-name" data-plan-summary-name></span>
      <span class="plan-summary-sep" aria-hidden="true">·</span>
      <span class="plan-summary-fee" data-plan-summary-fee></span>
    </p>
    <div class="plan-info">
      <p><strong>Se cobra cada mes con tu tarjeta hasta que te des de baja. Primer cobro: hoy.</strong></p>
      {/* PENDIENTE (Denisse): cuándo surte efecto la baja (condiciones, apartado 7). No se indica aquí hasta que lo confirme. */}
      <p>
        Cómo darte de baja: podrás darte de baja cuando quieras
        {STRIPE_PORTAL_URL ? <> desde tu <a href={STRIPE_PORTAL_URL} target="_blank" rel="noopener" aria-describedby={`${p}-newtab`}>portal de cliente</a> de Stripe o</> : ''}{' '}
        escribiéndonos por WhatsApp al <a href={waLink(WA_TEXT.autogestionDudas)} target="_blank" rel="noopener" aria-describedby={`${p}-newtab`}>{PHONE.display}</a> o a{' '}
        <a href={EMAIL.href}>{EMAIL.address}</a>. Más información en las{' '}
        <a href={url('/condiciones-contratacion/')} target="_blank" rel="noopener" aria-describedby={`${p}-newtab`}>condiciones de contratación</a>.
      </p>
    </div>

    {/* method="post": sin script, los datos nunca acaban en la URL. El botón nace desactivado. */}
    <form class="plan-form" method="post" novalidate data-plan-form>
      <div class="plan-grid">
        <Field name="nombre" id={`${p}-nombre`} label="Nombre" required autocomplete="name" maxlength={120} msgRequired="Escribe tu nombre." />
        <Field
          name="email"
          id={`${p}-email`}
          label="Email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          maxlength={160}
          msgRequired="Escribe tu email: lo necesitamos para gestionar tu plan."
        />
        <Field
          name="telefono"
          id={`${p}-telefono`}
          label="Teléfono"
          type="tel"
          required
          autocomplete="tel"
          inputmode="tel"
          maxlength={25}
          full
          msgRequired="Escribe tu teléfono (puedes incluir el prefijo, por ejemplo +34)."
        />

        <div class="field field--full field--consent">
          <label class="consent" for={`${p}-rgpd`}>
            <input
              id={`${p}-rgpd`}
              name="rgpd"
              type="checkbox"
              required
              aria-describedby={`${p}-rgpd-error`}
              data-msg-required="Marca esta casilla para confirmar que has leído la política de privacidad."
            />
            <span>
              <span data-consent-text>{privBefore}<a href={url('/politica-privacidad/')} target="_blank" rel="noopener" aria-describedby={`${p}-newtab`}>{privLink}</a>{privAfter}</span>
              <span class="req" aria-hidden="true">*</span>
            </span>
          </label>
          <p class="field-error" id={`${p}-rgpd-error`} data-error-for="rgpd"></p>
        </div>

        <div class="field field--full field--consent">
          <label class="consent" for={`${p}-desistimiento`}>
            <input
              id={`${p}-desistimiento`}
              name="desistimiento"
              type="checkbox"
              required
              aria-describedby={`${p}-desistimiento-error`}
              data-msg-required="Marca esta casilla para contratar: con ella pides que el servicio empiece ya y aceptas las condiciones de contratación."
            />
            <span>
              {
                plans.map((pl) => {
                  const [before, link, after] = linkParts(pl.desist, LINK_PHRASES.terms);
                  return (
                    <span data-consent-text data-desist-for={pl.key} hidden>{before}<a href={url('/condiciones-contratacion/')} target="_blank" rel="noopener" aria-describedby={`${p}-newtab`}>{link}</a>{after}</span>
                  );
                })
              }
              <span class="req" aria-hidden="true">*</span>
            </span>
          </label>
          <p class="field-error" id={`${p}-desistimiento-error`} data-error-for="desistimiento"></p>
        </div>
        <span id={`${p}-newtab`} hidden>Se abre en una pestaña nueva</span>

        <div class="hp-field" aria-hidden="true">
          <label for={`${p}-website`}>No rellenes este campo</label>
          <input id={`${p}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
      </div>

      <p class="form-status" role="status" aria-live="polite" data-form-status></p>

      <div class="plan-actions">
        <button class="btn btn--primary plan-submit" type="submit" disabled data-submit>
          <Icon name="lock" />
          <span data-submit-label>Pagar y contratar</span>
        </button>
        <p class="plan-note">Pago con tarjeta a través de Stripe. Esta web no recibe ni guarda los datos de tu tarjeta.</p>
      </div>

      <noscript>
        <p class="form-noscript">
          Para contratar en la web necesitas JavaScript. <a href={waLink(WA_TEXT.autogestionDudas)} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> o llámanos al{' '}
          <a href={TEL_LINK}>{PHONE.display}</a>.
        </p>
      </noscript>

      <p class="form-mock" data-plan-mock hidden>
        <strong>Modo de prueba:</strong> la contratación de este plan todavía no está conectada a AccioGest. No se cobra nada: al continuar se simula el pago y vas a la página de agradecimiento.
      </p>
    </form>
  </div>
</FormDialog>

<script>
  import { initPlanCheckout } from '~/scripts/plan-checkout';
  initPlanCheckout(document.querySelector<HTMLDialogElement>('[data-plan-dialog]'));
</script>

<style>
  .plan-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .25rem .5rem;
    margin-bottom: 1rem;
    padding: .9rem 1.1rem;
    border: 1px solid rgba(110, 29, 122, .16);
    border-radius: 12px;
    background: var(--c-white);
  }
  .plan-summary[hidden] { display: none; }
  .plan-summary-sep { color: var(--c-muted); }
  .plan-info { margin-bottom: 1.5rem; color: var(--c-ink-soft); font-size: .92rem; line-height: 1.55; }
  .plan-info > * + * { margin-top: .5rem; }
  .plan-info strong { color: var(--c-ink); font-weight: 600; }
  .plan-info a { color: var(--c-plum); font-weight: 600; overflow-wrap: anywhere; }
  .plan-summary-name { color: var(--c-plum); font-weight: 600; letter-spacing: .04em; }
  .plan-summary-fee { color: var(--c-ink); font-weight: 600; }
  .plan-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 600px) {
    .plan-grid { grid-template-columns: 1fr 1fr; column-gap: 1.25rem; }
    .plan-grid > :global(.field--full) { grid-column: 1 / -1; }
  }
  .field--consent { padding-top: .25rem; }
  .field--consent :global(.consent) { overflow-wrap: anywhere; }
  .plan-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .plan-submit { min-height: 54px; padding-inline: 1.75rem; }
  .plan-submit :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .plan-submit[aria-disabled="true"],
  .plan-submit:disabled { opacity: .62; cursor: not-allowed; box-shadow: none; }
  .plan-submit[aria-busy="true"] { cursor: progress; }
  .plan-submit[aria-disabled="true"]:active,
  .plan-submit:disabled:active { transform: none; }
  .plan-note { flex: 1 1 14rem; color: var(--c-muted); font-size: .88rem; line-height: 1.5; }
  .form-status:not(:empty) { display: block; line-height: 1.5; margin-top: 1.25rem; }
  .form-status :global(span) { display: block; }
  .form-status :global(.form-status-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: .25rem;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .form-mock {
    margin-top: 1.25rem;
    padding: .75rem 1rem;
    border: 1px dashed var(--c-line-strong);
    border-radius: 10px;
    background: rgba(243, 237, 245, .6);
    color: var(--c-ink-soft);
    font-size: .85rem;
    line-height: 1.5;
  }
  .form-mock[hidden] { display: none; }
  .form-noscript {
    margin-top: 1.25rem;
    padding: .75rem 1rem;
    border-radius: 10px;
    background: var(--c-error-bg);
    font-size: .92rem;
    line-height: 1.5;
  }
  .form-noscript a { color: var(--c-plum); font-weight: 600; }
  @media (max-width: 599.98px) {
    .plan-submit { width: 100%; }
  }
</style>
