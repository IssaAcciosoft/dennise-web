---
/**
 * Formulario de lead de AccioGest (historia, servicio o contacto): campos (slot), casilla de
 * consentimiento, campo trampa, estado accesible (aria-live), botón y panel de resultado.
 * Lo controla src/scripts/lead-form.ts (initLeadForm sobre [data-lead]); lo inicializa el
 * componente que lo usa (diálogo o página).
 *
 * Con un ID de ejemplo (modo simulado) muestra un aviso visible: nunca se pierde un mensaje
 * sin que la persona lo sepa.
 */
import { FORMS, isConfigured, type FormKey } from '~/config/acciogest';
import { CONSENT } from '~/data/legal';
import { waLink } from '~/data/site';
import { url } from '~/lib/url';
import Icon from '../ui/Icon.astro';

interface Props {
  formKey: FormKey;
  idPrefix: string;
  submitLabel: string;
  successTitle: string;
  /** Texto de éxito si no hay mensaje de la API (y para el campo trampa). */
  successText?: string;
  /** Mensaje predefinido de WhatsApp para la alternativa. */
  waText: string;
  variant?: 'brand' | 'ev';
  /** Dentro de un <dialog>: el resultado ofrece «Cerrar». */
  inDialog?: boolean;
  againLabel?: string;
}

const {
  formKey,
  idPrefix,
  submitLabel,
  successTitle,
  successText = 'Hemos recibido tu mensaje correctamente.',
  waText,
  variant = 'brand',
  inDialog = false,
  againLabel = 'Enviar otro mensaje',
} = Astro.props;

const mock = !isConfigured(FORMS[formKey]);
const btnClass = variant === 'ev' ? 'btn--ev' : 'btn--primary';
---

<div class:list={['lead-box', `lead-box--${variant}`]} data-lead={formKey} data-wa-text={waText} data-success-text={successText}>
  <form class="lead-form" novalidate data-lead-form={formKey}>
    <div class="form-grid">
      <slot />

      <div class="field field--full field--consent">
        <label class="consent" for={`${idPrefix}-consentimiento`}>
          <input
            id={`${idPrefix}-consentimiento`}
            name="consentimiento"
            type="checkbox"
            value="sí"
            required
            aria-describedby={`${idPrefix}-consentimiento-error`}
            data-msg-required="Necesito tu consentimiento para poder recibir tus datos."
          />
          <span>
            He leído y acepto la <a href={url('/politica-privacidad/')} target="_blank" rel="noopener">política de privacidad<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a> y {CONSENT[formKey]}
            <span class="req" aria-hidden="true">*</span>
          </span>
        </label>
        <p class="field-error" id={`${idPrefix}-consentimiento-error`} data-error-for="consentimiento"></p>
      </div>

      <div class="hp-field" aria-hidden="true">
        <label for={`${idPrefix}-website`}>No rellenes este campo</label>
        <input id={`${idPrefix}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <p class="form-status" role="status" aria-live="polite" data-form-status></p>

    <div class="form-actions">
      <button class:list={['btn', btnClass, 'lead-submit']} type="submit" data-submit>
        <span data-submit-label>{submitLabel}</span>
        <Icon name="arrow" />
      </button>
      <slot name="note" />
    </div>

    {
      mock && (
        <p class="form-mock" data-form-mock>
          <strong>Modo de prueba:</strong> este formulario todavía no está conectado y los envíos no me llegan. Para contactarme ahora,{' '}
          <a href={waLink(waText)} target="_blank" rel="noopener">escríbeme por WhatsApp</a>.
        </p>
      )
    }
  </form>

  <div class="lead-result" data-lead-result hidden>
    <span class="lead-result-icon" aria-hidden="true"><Icon name="check" /></span>
    <h3 class="lead-result-title" tabindex="-1" data-result-title>{successTitle}</h3>
    <p class="lead-result-text" data-result-text></p>
    <p class="lead-result-mock" data-result-mock hidden>
      Modo de prueba: el formulario aún no está conectado a AccioGest, así que este envío no me ha llegado.
    </p>
    <div class="lead-result-actions">
      {inDialog && (
        <button class:list={['btn', btnClass]} type="button" data-dialog-close>Cerrar</button>
      )}
      <button class="btn btn--ghost" type="button" data-lead-again>{againLabel}</button>
    </div>
  </div>
</div>

<style>
  .form-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 600px) {
    .form-grid { grid-template-columns: 1fr 1fr; column-gap: 1.25rem; }
    .form-grid > :global(.field--full),
    .form-grid > .field--consent { grid-column: 1 / -1; }
  }
  .field--consent { padding-top: .25rem; }

  .form-status:not(:empty) { display: block; line-height: 1.5; }
  .form-status :global(.form-status-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: .25rem;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .form-status :global(.form-status-link)::after { content: "→"; margin-left: .4rem; text-decoration: none; }
  .form-status :global(span) { display: block; }
  .lead-box { scroll-margin-top: calc(var(--header-h) + 2.5rem); }
  .form-status:not(:empty)[data-tone="info"] { font-weight: 500; }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .lead-submit { min-height: 54px; padding-inline: 1.75rem; }
  .lead-submit[aria-disabled="true"] { opacity: .62; cursor: not-allowed; box-shadow: none; }
  .lead-submit[aria-busy="true"] { cursor: progress; }
  .lead-submit[aria-disabled="true"]:active { transform: none; }
  .lead-submit :global(.icon) { transition: transform var(--dur) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .lead-submit:not([aria-disabled="true"]):hover :global(.icon) { transform: translateX(3px); }
  }
  .form-actions :global(.form-note) { flex: 1 1 14rem; color: var(--c-muted); font-size: .88rem; line-height: 1.5; }

  .form-mock {
    margin-top: 1.25rem;
    padding: .75rem 1rem;
    border: 1px dashed var(--c-line-strong);
    border-radius: 10px;
    background: rgba(243, 237, 245, .6);
    color: var(--c-ink-soft);
    font-size: .85rem;
    line-height: 1.5;
  }
  .form-mock a { color: var(--c-plum); font-weight: 600; }

  .lead-result { padding-block: .5rem; text-align: center; }
  .lead-result:focus { outline: none; }
  .lead-result-icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: var(--c-plum);
    color: #fff;
  }
  .lead-box--ev .lead-result-icon { background: var(--ev-gold); color: var(--ev-bg); }
  .lead-result-icon :global(.icon) { width: 2rem; height: 2rem; }
  .lead-result-title {
    font-family: var(--ff-serif);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.15;
    color: var(--c-ink);
    text-wrap: balance;
  }
  .lead-result-title:focus { outline: none; }
  .lead-result-title:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .lead-result-text { max-width: 32rem; margin: .9rem auto 0; color: var(--c-ink-soft); text-wrap: pretty; }
  .lead-result-mock {
    max-width: 32rem;
    margin: 1rem auto 0;
    padding: .6rem .9rem;
    border: 1px dashed var(--c-line-strong);
    border-radius: 10px;
    color: var(--c-muted);
    font-size: .85rem;
  }
  .lead-result-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1.75rem; }

  /* Entrada del resultado: transición + @starting-style (interrumpible), solo opacidad y
     desplazamiento corto (Emil: < 300 ms, ease-out). Con movimiento reducido, solo opacidad. */
  .lead-result { transition: opacity var(--dur-slow) var(--ease-out), translate var(--dur-slow) var(--ease-out); }
  @starting-style {
    .lead-result:not([hidden]) { opacity: 0; translate: 0 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lead-result { transition-property: opacity; transition-duration: var(--dur) !important; }
  }

  @media (max-width: 599.98px) {
    .lead-submit { width: 100%; }
    .lead-result-actions :global(.btn) { width: 100%; }
  }
</style>
