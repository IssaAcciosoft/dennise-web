---
/**
 * Conóceme. Bloque principal «de la fundadora» (estructura de la referencia «Conoce a la fundadora», de
 * bread-communion.com, adaptada a la marca): a la izquierda antetítulo, retrato, nombre
 * completo, tres líneas con datos suyos, frase destacada y dos líneas de cierre; a la derecha
 * el titular y sus párrafos en primera persona (tal cual, docs/contenido.md → CONÓCEME).
 * «Trayectoria reciente» (solo 2024–2026) va bajo la tarjeta en escritorio y tras el texto en móvil. Debajo: Mi propósito, Actividad reciente (agenda 2026), Experiencia, Mi trayectoria, el globo y
 * «El despacho».
 *
 * El retrato es el MISMO archivo que el del hero del inicio: la transición entre páginas lo
 * convierte en una sola foto que viaja (BaseLayout → portrait, global.css §8).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import Experience from '~/components/about/Experience.astro';
import Timeline from '~/components/about/Timeline.astro';
import GlobeSlot from '~/components/about/GlobeSlot.astro';
import ContactCta from '~/components/contact/ContactCta.astro';
import Firm from '~/components/about/Firm.astro';
import RecentActivity from '~/components/about/RecentActivity.astro';
import { BOOKING_PATH, SITE } from '~/data/site';
import { url } from '~/lib/url';
import retrato from '~/assets/img/despacho-retrato.jpg';

// Tres líneas con datos de docs/contenido.md (profesión, áreas y cargos), sin adjetivos propios.
// docs/cambios-2026-10.md §1: presidenta y fundadora de DG; además de abogada, gestora administrativa.
const roles = [
  `Presidenta y fundadora de ${SITE.firm}`,
  'Abogada y gestora administrativa · Extranjería y movilidad internacional',
  'Directora ejecutiva de Jóvenes por los Derechos Humanos España',
  'Delegada · International Human Rights Summit 2026',
];

// Trayectoria reciente (docs/contenido.md → MI TRAYECTORIA y DERECHOS HUMANOS), de lo más
// reciente a lo más antiguo. Solo 2024–2026: Poplavsky (2020–2023) y el Centro de Justicia para
// la Mujer (2018–2019) ya están en «Mi trayectoria», más abajo, y con ellos esta columna acababa
// ~350 px por debajo del texto en escritorio (VISUAL-04).
const recent: { title: string; role: string; from: string; to?: string }[] = [
  { title: 'International Human Rights Summit, Nueva York', role: 'Delegada', from: '2026' },
  { title: 'Jóvenes por los Derechos Humanos España', role: 'Directora ejecutiva', from: '2026' },
  { title: 'Embajada de México en España', role: 'Litigio estratégico', from: '2024' },
];
---

<BaseLayout
  title="Conóceme a Denisse González · DG Gestores y Abogados"
  description="Denisse González, abogada mexicana con formación jurídica internacional y experiencia profesional entre México y España: trayectoria, experiencia y propósito."
  preloadFonts={['serif-600', 'serif-500', 'sans-400', 'sans-600']}
>
  <section class="founder" aria-labelledby="about-title">
    <div class="container founder-grid">
      <div class="founder-card">
        <p class="eyebrow founder-eyebrow">Conóceme</p>
        <figure class="founder-photo">
          <div class="founder-frame vt-portrait">
            <Photo
              src={retrato}
              alt="Denisse González en su despacho, junto al logotipo de DG y las banderas de México y España"
              widths={[320, 420, 560, 736, 880]}
              sizes="(min-width: 960px) 23rem, min(calc(100vw - 2rem), 23rem)"
              priority
            />
          </div>
        </figure>
        <p class="founder-name">{SITE.name}</p>
        <ul class="founder-roles" role="list">
          {roles.map((r) => <li>{r}</li>)}
        </ul>
        <blockquote class="founder-quote">
          <p>«Porque detrás de cada expediente hay una persona.»</p>
        </blockquote>
        <p class="founder-sign">
          <span>{SITE.motto}</span>
          {/* docs/cambios-2026-10.md §2.5: no trabaja en Nueva York */}
          <span>México&nbsp;· España</span>
        </p>
      </div>

      <div class="founder-story">
        <h1 class="founder-title" id="about-title">Una trayectoria entre el derecho, las fronteras y las personas.</h1>
        <div class="prose founder-prose">
          <p>Soy Denisse González, abogada mexicana con formación jurídica internacional y experiencia profesional desarrollada entre México y España.</p>
          <p>Mi trayectoria comenzó en la práctica jurídica y la litigación, y con el tiempo fue incorporando nuevas dimensiones: el derecho internacional, la movilidad internacional, la gestión administrativa, las relaciones institucionales y la defensa y promoción de los derechos humanos.</p>
          <p>He trabajado en despachos jurídicos, en asesoría migratoria y en instituciones como la Embajada de México en España, donde colaboré en litigio estratégico. También he ejercido como abogada litigante en materias civil, penal y de amparo, y como directora legal para México en Poplavsky International Law Offices, participando en la representación de demandas internacionales.</p>
          <p>Pero mi trayectoria no se ha construido únicamente dentro de un despacho.</p>
          <p>Una parte esencial de mi camino ha estado vinculada al trabajo con personas y comunidades. Desde mis primeras prácticas en el Centro de Justicia para la Mujer, donde participé en la asesoría legal a mujeres víctimas de violencia de género, hasta mi actual participación en iniciativas de derechos humanos.</p>
          <p>Hoy entiendo el derecho como una herramienta para conectar personas con oportunidades, instituciones con comunidades y derechos con realidades concretas.</p>
          <p>Mi formación también refleja esa visión: Derecho, una Maestría en Derecho con especialización en Litigios Orales, un Máster en Derecho Internacional, Comercio y Relaciones Internacionales, formación en Negociación en NYU y un Máster en Gestión Administrativa.</p>
        </div>
      </div>

      {/* Hermano de la columna del texto (no hijo): en móvil va después del texto, como
          antes; en escritorio ocupa la columna de la foto bajo la tarjeta, que se quedaba
          vacía mientras el texto seguía (~700 px). */}
      <div class="founder-recent">
        <h2 class="founder-label" id="recent-title">Trayectoria reciente</h2>
        <ul class="recent-list" role="list" aria-labelledby="recent-title">
          {
            recent.map((item) => (
              <li>
                <strong class="recent-title">{item.title}</strong>
                <span class="recent-role">
                  {item.role} (<time datetime={item.from}>{item.from}</time>{item.to && <>–<time datetime={item.to}>{item.to}</time></>})
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="purpose" aria-labelledby="purpose-title">
    <div class="container">
      <div class="purpose-grid">
        <h2 class="founder-label purpose-label" id="purpose-title" data-reveal>Mi propósito</h2>
        <div class="purpose-body">
          <p class="purpose-text" data-reveal>Trabajar en la intersección entre derecho, movilidad internacional y derechos humanos, acompañando a personas, organizaciones e instituciones que necesitan comprender, gestionar o defender sus derechos dentro de contextos cada vez más internacionales.</p>
          <div class="purpose-close" data-reveal>
            <p>Porque detrás de cada expediente hay una persona.</p>
            <p>Y detrás de cada trámite, una historia, un proyecto de vida o una oportunidad que merece ser tomada en serio.</p>
          </div>
          <div class="btn-row purpose-actions" data-reveal>
            <a class="btn btn--primary" href={url(BOOKING_PATH)}>
              <Icon name="calendar" />
              <span>Reserva tu asesoría</span>
            </a>
            <a class="btn btn--link" href="#trayectoria">
              <span>Ver mi trayectoria</span>
              <Icon name="arrow" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Agenda 2026 y campañas informativas (docs/redes-sociales.md §4) */}
  <RecentActivity />

  <Experience />
  <Timeline />

  <section class="section section--white crossing" aria-labelledby="crossing-title">
    <div class="container crossing-grid">
      <div class="crossing-copy">
        <h2 class="section-title" id="crossing-title" data-reveal>Una carrera que continúa cruzando fronteras.</h2>
        <p class="lead" data-reveal>Mi experiencia profesional se ha desarrollado en distintos espacios jurídicos e institucionales, pero existe un hilo conductor: las personas que necesitan encontrar una solución dentro de sistemas que muchas veces pueden resultar complejos.</p>
      </div>
      <!-- Globo 3D (México · España): src/components/about/GlobeSlot.astro -->
      <GlobeSlot class="crossing-globe" />
    </div>
  </section>

  {/* El despacho: historia, misión, valores, Nuestro equipo y Partners (docs/web-anterior.md §3, docs/cambios-2026-10.md §3-4) */}
  <Firm />

  <ContactCta />
</BaseLayout>

<style>
  /* ---------- Bloque de la fundadora ---------- */
  .founder {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    background:
      radial-gradient(60rem 40rem at 100% 0%, rgba(232, 221, 236, .7), transparent 62%),
      var(--c-ivory);
  }
  .founder-grid { display: grid; gap: clamp(3rem, 8vw, 4.5rem); }

  .founder-card { min-width: 0; }
  .founder-eyebrow { margin-bottom: 1.5rem; }
  .founder-photo { width: min(100%, 23rem); margin: 0; }
  .founder-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--c-lavender-200);
  }
  .founder-frame :global(picture),
  .founder-frame :global(img) { width: 100%; height: 100%; }
  .founder-frame :global(img) { object-fit: cover; }
  .founder-name {
    margin-top: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-family: var(--ff-serif);
    /* Por debajo del H1 (.founder-title): nombre < titular ≥ títulos de sección. */
    font-size: clamp(1.8rem, 1.5rem + 1vw, 2.4rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -.012em;
    color: var(--c-ink);
    text-wrap: balance;
  }
  .founder-roles {
    display: grid;
    gap: .3rem;
    margin-top: 1.25rem;
    color: var(--c-muted);
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  .founder-quote {
    margin-top: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    max-width: 21rem;
  }
  .founder-quote p {
    font-family: var(--ff-serif);
    font-size: clamp(1.75rem, 1.45rem + 1.1vw, 2.3rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.22;
    color: var(--c-terracotta-700);
    text-wrap: balance;
  }
  .founder-sign {
    display: grid;
    gap: .2rem;
    margin-top: 1.5rem;
    color: var(--c-muted);
    font-size: .85rem;
    line-height: 1.5;
  }

  .founder-story { min-width: 0; }
  .founder-title {
    max-width: 17em;
    margin-bottom: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-family: var(--ff-serif);
    /* Escala de H1 (a la par de los .section-title de la página, no por debajo). */
    font-size: clamp(2.4rem, 1.6rem + 2.8vw, 4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.01em;
    color: var(--c-ink);
    text-wrap: balance;
  }
  .founder-prose { max-width: 38rem; }
  .founder-prose p + p { margin-top: 1.15em; }

  /* Rótulo pequeño en mayúsculas (Trayectoria reciente, Mi propósito) */
  .founder-label {
    color: var(--c-ink);
    font-family: var(--ff-sans);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .2em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .founder-recent {
    max-width: 38rem;
    padding-top: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    border-top: 1px solid var(--c-line);
  }
  .recent-list { margin-top: 1.25rem; }
  .recent-list li {
    display: grid;
    gap: .2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-line);
  }
  .recent-list li:first-child { padding-top: 0; }
  .recent-list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .recent-title { color: var(--c-ink); font-weight: 600; line-height: 1.4; }
  .recent-role { color: var(--c-muted); font-size: var(--fs-small); line-height: 1.5; font-variant-numeric: lining-nums tabular-nums; }

  @media (min-width: 960px) {
    .founder-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      grid-template-areas: "card story" "recent story";
      grid-template-rows: auto 1fr;
      column-gap: clamp(3.5rem, 7vw, 7.5rem);
      row-gap: 0;
      align-items: start;
    }
    .founder-card { grid-area: card; }
    .founder-story { grid-area: story; }
    .founder-recent { grid-area: recent; max-width: 23rem; margin-top: 2rem; padding-top: 1.75rem; }
    /* El titular a la altura de la foto, como en la referencia */
    .founder-story { padding-top: calc(1.5rem + .8rem * 1.4); }
  }

  /* ---------- Mi propósito ---------- */
  .purpose { padding-bottom: var(--section-pad); background: var(--c-ivory); }
  .purpose-grid {
    display: grid;
    gap: 1.5rem;
    padding-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    border-top: 1px solid var(--c-line);
  }
  .purpose-label { color: var(--c-plum); }
  .purpose-text {
    max-width: 30em;
    font-family: var(--ff-serif);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.05rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.32;
    color: var(--c-plum-800);
    text-wrap: pretty;
  }
  .purpose-close {
    max-width: 38rem;
    margin-top: 1.75rem;
    color: var(--c-ink-soft);
  }
  .purpose-close p + p { margin-top: .35rem; }
  .purpose-actions { margin-top: 2.25rem; }
  @media (min-width: 960px) {
    .purpose-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); column-gap: clamp(3.5rem, 7vw, 7.5rem); }
    .purpose-label { padding-top: .7rem; }
  }

  /* El globo y «El despacho» comparten fondo blanco: sin la mitad del padding inferior, el
     paso entre las dos secciones no parece un hueco (sobre todo en móvil). */
  .crossing { padding-bottom: calc(var(--section-pad) / 2); }
  .crossing-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .crossing-copy .section-title { margin-bottom: 1.5rem; max-width: 7.7em; }
  .crossing-copy .lead { max-width: 36rem; }
  @media (min-width: 960px) {
    .crossing-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
</style>
