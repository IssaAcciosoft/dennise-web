---
/**
 * /gracias/ — página de agradecimiento tras contratar un plan o reservar una asesoría en
 * AccioGest. No se indexa, no está en el menú ni en el sitemap (astro.config.mjs → NOINDEX).
 *
 *   /gracias/?tipo=plan&plan=basico|estandar|premium   (vuelta desde la página de pago del plan,
 *                                                       con &response_id=…&pago=ok)
 *   /gracias/?tipo=reserva                              (+ &cita=… desde el widget, BookingSlot)
 *   /gracias/                       (genérica)
 *
 * Planes de Autogestión DG, PAGO ÚNICO (AccioGest en real desde el 27-11-2026, pagos en vivo):
 * la página de pago de cada plan solo redirige aquí cuando el pago se ha completado, con
 * ?tipo=plan&plan=<clave>&response_id=…&pago=ok. Aquí no se comprueba ningún parámetro de pago:
 * con o sin response_id / pago=ok se muestra lo mismo (pago completado). Tras una reserva, el
 * widget avisa con postMessage y la web viene aquí con ?tipo=reserva. cita y response_id no se
 * muestran ni se usan (nunca se escribe texto de la URL en la página: solo se eligen bloques ya
 * escritos y nombres e importes conocidos). El justificante del pago lo envía Stripe por correo.
 * Lo que incluye el plan contratado sale de servicios.json → plans[].includes; sin ?plan=
 * conocido, la lista no se muestra.
 * PENDIENTE (cliente): los pasos y plazos tras la compra no están confirmados; cuando la cliente
 * los confirme, se podrá añadir una lista numerada.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { autogestion, planIncludes, formatAmount, CATALOG } from '~/lib/services';
import { WA_TEXT, waLink } from '~/data/site';
import { url } from '~/lib/url';
import { safeJson } from '~/lib/json';

// Solo nombres conocidos (nunca se muestra texto de la URL): búsqueda por propiedad PROPIA
// (?plan=constructor o toString no deben resolver a las del prototipo).
const planNames = Object.fromEntries(autogestion.plans.flatMap((p) => [[p.form_key, p.name], [p.id, p.name]]));
// Clave (form_key o id) → form_key: qué lista de «Lo que incluye tu plan» se muestra.
const planKeys = Object.fromEntries(autogestion.plans.flatMap((p) => [[p.form_key, p.form_key], [p.id, p.form_key]]));
// Clave (form_key o id) → importe («242 €»); sin precio visible, no hay importe que mostrar.
const fee = (amount: number) => `${formatAmount(amount)} €`;
const planFees = Object.fromEntries(
  autogestion.plans.flatMap((p) => (p.amount === null ? [] : [[p.form_key, fee(p.amount)], [p.id, fee(p.amount)]])),
);
// Solo se mira tipo y plan: AccioGest solo vuelve aquí con el pago completado (pago=ok y
// response_id se ignoran).
const variantScript = `(function(){try{var q=new URLSearchParams(location.search),t=q.get('tipo'),v=t==='plan'||t==='reserva'?t:'';if(v){document.querySelectorAll('[data-thanks]').forEach(function(el){el.hidden=el.getAttribute('data-thanks')!==v})}var m=${safeJson(planNames)},k=q.get('plan')||'',n=Object.prototype.hasOwnProperty.call(m,k)?m[k]:'';if(typeof n==='string'&&n){document.querySelectorAll('[data-plan-name]').forEach(function(el){el.textContent=n})}var pk=${safeJson(planKeys)},f=Object.prototype.hasOwnProperty.call(pk,k)?pk[k]:'';if(typeof f==='string'&&f){document.querySelectorAll('[data-plan-includes]').forEach(function(el){el.hidden=el.getAttribute('data-plan-includes')!==f})}var pf=${safeJson(planFees)},c=Object.prototype.hasOwnProperty.call(pf,k)?pf[k]:'';if(typeof c==='string'&&c){document.querySelectorAll('[data-plan-fee]').forEach(function(el){el.textContent=c});document.querySelectorAll('[data-plan-fee-line]').forEach(function(el){el.hidden=false})}}catch(e){}})();`;
---

<BaseLayout
  title="Gracias · DG Gestores y Abogados"
  description="Gracias por confiar en DG Gestores y Abogados."
  noindex
>
  <section class="thanks" data-wa-hide>
    <div class="container container--narrow thanks-inner">
      <span class="thanks-icon" aria-hidden="true"><Icon name="check" /></span>

      <div class="thanks-block" data-thanks="default">
        <h1 class="page-title">Gracias.</h1>
        <p class="lead">Hemos recibido tu solicitud.</p>
      </div>

      <div class="thanks-block" data-thanks="plan" hidden>
        <p class="eyebrow eyebrow--center">{autogestion.name}</p>
        <h1 class="page-title">Gracias por contratar el <span data-plan-name>plan</span>.</h1>
        <p class="lead">Tu pago se ha completado.</p>
        <p class="lead thanks-fee" data-plan-fee-line hidden>Pago único: <strong data-plan-fee></strong> ({CATALOG.tax_label}).</p>
        <p class="thanks-note">Recibirás por correo el justificante del pago.</p>
        <p class="thanks-note">Más información en las <a href={url('/condiciones-contratacion/')}>condiciones de contratación</a>.</p>
        {
          autogestion.plans.map((plan) => (
            <div class="thanks-steps" data-plan-includes={plan.form_key} hidden>
              <h2 class="thanks-steps-title">Lo que incluye tu plan</h2>
              <ul class="check-list thanks-list" role="list">
                {planIncludes(plan).map((item) => (
                  <li>
                    <Icon name="check" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="thanks-block" data-thanks="reserva" hidden>
        <p class="eyebrow eyebrow--center">Asesorías</p>
        <h1 class="page-title">Gracias por reservar tu asesoría.</h1>
        <p class="lead">Tu reserva se ha completado.</p>
      </div>

      <p class="thanks-help">¿Tienes alguna duda?</p>
      <div class="btn-row thanks-actions">
        <a class="btn btn--primary" href={waLink(WA_TEXT.general)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span>Escríbenos por WhatsApp</span>
        </a>
        <a class="btn btn--ghost" href={url('/servicios/')}>
          <span>Volver a servicios</span>
        </a>
        <a class="btn btn--link" href={url('/')}>
          <span>Ir al inicio</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
  <script is:inline set:html={variantScript} />
</BaseLayout>

<style>
  .thanks {
    padding-block: clamp(3rem, 2rem + 6vw, 7rem);
    background:
      radial-gradient(50rem 30rem at 100% 0%, rgba(232, 221, 236, .85), transparent 62%),
      var(--c-ivory);
  }
  .thanks-inner { display: grid; justify-items: center; text-align: center; }
  .thanks-icon {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 1.75rem;
    border-radius: 50%;
    background: var(--c-plum);
    color: #fff;
    box-shadow: 0 14px 30px -14px rgba(110, 29, 122, .7);
  }
  .thanks-icon :global(.icon) { width: 2.2rem; height: 2.2rem; }
  .thanks-block:not([hidden]) { display: grid; justify-items: center; gap: 1.25rem; }
  .thanks-block .page-title { max-width: 14em; }
  .thanks-block .lead { max-width: 34rem; }
  .thanks-steps {
    width: 100%;
    margin-top: 1.25rem;
    padding: clamp(1.25rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-white);
    text-align: left;
  }
  .thanks-steps-title { margin-bottom: 1rem; font-family: var(--ff-serif); font-size: var(--fs-h4); font-weight: 600; }
  .thanks-list { gap: .85rem; }
  .thanks-help { margin-top: 2rem; color: var(--c-ink-soft); }
  .thanks-fee strong { color: var(--c-plum); font-weight: 600; }
  .thanks-note { max-width: 34rem; color: var(--c-ink-soft); text-wrap: pretty; }
  .thanks-note a { color: var(--c-plum); font-weight: 600; }
  .thanks-actions { justify-content: center; margin-top: 1.25rem; }
</style>
