---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import Consultations from '~/components/services/Consultations.astro';
import FirmServices from '~/components/services/FirmServices.astro';
import BookingSlot from '~/components/services/BookingSlot.astro';
import ServiceRequestDialog from '~/components/services/ServiceRequestDialog.astro';
import ServicesTour from '~/components/services/ServicesTour.astro';
import Immigration from '~/components/services/Immigration.astro';
import ServicesFaq from '~/components/services/ServicesFaq.astro';
import { FAQ_SPAIN, faqJsonLd } from '~/data/faq';
import { autogestion, AUTOGESTION_PATH } from '~/lib/services';
import { url } from '~/lib/url';
import { safeJson } from '~/lib/json';
import despacho from '~/assets/img/despacho.jpg';
---

<BaseLayout
  title="Servicios de extranjería y precios · DG Gestores y Abogados"
  description="Extranjería en España (arraigos, reagrupación familiar, nacionalidad, estudios, nómadas digitales…), gestión administrativa, homologación de títulos y asesoría migratoria online y presencial: precios y reserva de asesorías."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={safeJson(faqJsonLd(FAQ_SPAIN))} />
  </Fragment>

  <section class="services-hero" aria-labelledby="services-title">
    <div class="container services-intro">
      <div class="services-intro-copy">
        <p class="eyebrow">Servicios de extranjería</p>
        <h1 class="page-title" id="services-title">Un trámite puede cambiar tu vida.</h1>
        <p class="lead services-lead">Expertos en extranjería. Tu tranquilidad y confianza son nuestra prioridad. Contáctanos hoy y deja tu caso en manos profesionales.</p>
        {/* Su frase (Facebook, 10/09/2026; docs/redes-sociales.md §6) */}
        <p class="services-trust">No solo somos extranjería. <em>Somos humanidad.</em></p>
        {/* Modalidades: dato (texto con icono), no botones. Acción principal: reservar; la visita
            guiada queda como acción secundaria, separada de los datos. */}
        <ul class="services-modes" role="list" aria-label="Modalidades">
          <li><Icon name="monitor" />Online</li>
          <li><Icon name="handshake" />Presencial</li>
        </ul>
        <div class="services-actions">
          <a class="btn btn--primary" href="#reservar">
            <span>Reserva tu asesoría</span>
            <Icon name="arrow" />
          </a>
          <ServicesTour />
        </div>
      </div>
      <figure class="services-media">
        <div class="frame frame--offset">
          <Photo src={despacho} alt="Denisse González firmando documentos en su escritorio" widths={[320, 400]} sizes="(min-width: 700px) 340px, 300px" priority />
        </div>
      </figure>
    </div>
  </section>

  {/* Índice de la página (larga): atajos a cada bloque. Fuera del hero para que, en escritorio
      (≥ 1160 px), se quede fijo bajo la cabecera mientras se recorre la página. En móvil es una
      fila que se desliza en horizontal (sin partir etiquetas). */}
  <nav class="services-index" aria-label="En esta página">
    <div class="container">
      <ul role="list">
        <li><a href="#extranjeria">Extranjería</a></li>
        <li><a href="#gestoria">Gestoría</a></li>
        <li><a href="#asesorias">Asesorías y precios</a></li>
        <li><a href="#reservar">Reservar</a></li>
        <li><a href="#preguntas">Preguntas frecuentes</a></li>
      </ul>
    </div>
  </nav>

  <Immigration />

  <FirmServices />

  <section class="section section--ivory services-block" id="asesorias" aria-labelledby="asesorias-title">
    <div class="container">
      <div class="block-head">
        <p class="eyebrow" data-reveal>Precios</p>
        <h2 class="section-title" id="asesorias-title" data-reveal>Asesorías</h2>
        <p class="lead block-sub" data-reveal>Precios por sesión, online o presencial.</p>
      </div>
      <Consultations />
      {/* Autogestión DG: página aparte y discreta; desde aquí, solo este enlace sobrio
          (docs/cambios-2026-10.md §2.8). Los protagonistas son los servicios individuales. */}
      <div class="self-service" data-reveal>
        <div class="self-service-copy">
          <p class="self-service-q">¿Prefieres gestionar tu trámite tú mismo?</p>
          <p class="self-service-sub">{autogestion.name}: gestiona tu propio trámite de extranjería con nuestro apoyo.</p>
        </div>
        <a class="btn btn--outline self-service-btn" href={url(AUTOGESTION_PATH)}><span>Ver {autogestion.name}</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <BookingSlot />

  <ServicesFaq />

  <ServiceRequestDialog slot="after" />
</BaseLayout>

<script>
  // Foco de luz en las tarjetas de servicios y planes (solo ratón; global.css §6).
  import { initSpotlight } from '~/scripts/spotlight';
  initSpotlight();
</script>

<style>
  .services-hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
    background:
      radial-gradient(60rem 40rem at 100% 0%, rgba(232, 221, 236, .85), transparent 62%),
      var(--c-ivory);
  }
  .services-intro { display: grid; gap: 3rem; align-items: center; }
  .services-intro-copy .page-title { margin-bottom: 1.5rem; max-width: 8em; }
  .services-lead { max-width: 34rem; margin-bottom: 1.75rem; }
  .services-trust {
    max-width: 34rem;
    margin-bottom: 1.75rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--c-plum);
    font-family: var(--ff-serif);
    font-size: clamp(1.3rem, 1.15rem + .6vw, 1.65rem);
    font-weight: 600; /* serif-600: ya precargada (sin cambio de fuente en la portada) */
    line-height: 1.3;
    color: var(--c-ink);
  }
  .services-trust em { font-style: normal; color: var(--c-plum); }
  .services-modes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem 0;
    margin-bottom: 1.5rem;
    color: var(--c-ink-soft);
    font-size: .95rem;
    font-weight: 600;
  }
  .services-modes li { display: inline-flex; align-items: center; gap: .45rem; }
  .services-modes li + li::before { content: "·"; margin-inline: .75rem; color: var(--c-muted); }
  .services-modes :global(.icon) { width: 1.15rem; height: 1.15rem; color: var(--c-plum); }
  .services-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; }
  /* Móvil: las dos acciones apiladas con el mismo ancho (VISUAL-22). */
  @media (max-width: 479.98px) {
    .services-actions > .btn,
    .services-actions > :global(.tour-btn) { width: 100%; justify-content: center; }
    .services-actions > :global(.tour-btn) { min-height: 50px; }
  }
  .services-index { padding-bottom: clamp(1rem, .5rem + 2vw, 2rem); background: var(--c-ivory); }
  .services-index ul {
    display: flex;
    gap: 0 1.75rem;
    padding-top: .5rem;
    border-top: 1px solid var(--c-line);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .services-index ul::-webkit-scrollbar { display: none; }
  /* Fila deslizable: un fundido a la derecha avisa de que hay más; el relleno final deja que
     el último enlace salga del fundido al llegar al final. */
  @media (max-width: 1159.98px) {
    .services-index ul {
      padding-right: 2.5rem;
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    }
  }
  .services-index li { flex: none; }
  .services-index a {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    min-height: 44px;
    color: var(--c-ink-soft);
    font-size: .95rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--c-line-strong);
    text-underline-offset: .3em;
    transition: color var(--dur-fast) var(--ease-hover), text-decoration-color var(--dur-fast) var(--ease-hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .services-index a:hover { color: var(--c-plum); text-decoration-color: currentColor; }
  }
  /* Escritorio: el índice se queda bajo la cabecera; los anclajes dejan sitio para los dos. */
  @media (min-width: 1160px) {
    .services-index {
      position: sticky;
      top: var(--header-h);
      z-index: 20;
      padding-bottom: 0;
      border-bottom: 1px solid var(--c-line);
    }
    .services-index ul { border-top: 0; padding-top: 0; }
    :global(html:has(.services-index)) { scroll-padding-top: calc(var(--header-h) + 44px + 12px); }
  }
  .services-media { position: relative; isolation: isolate; width: min(100% - 1.5rem, 320px); justify-self: center; }
  .services-media :global(img) { width: 100%; border-radius: var(--radius); }
  .frame--offset::before {
    content: "";
    position: absolute;
    inset: 2rem -1.5rem -1.5rem 2rem;
    background: var(--c-lavender-200);
    border-radius: var(--radius);
    z-index: -1;
  }
  /* Móvil: el fondo desplazado de la foto no invade el margen lateral (16 px). */
  @media (max-width: 639.98px) {
    .frame--offset::before { inset: 1rem -.75rem -.75rem 1rem; }
  }
  @media (min-width: 700px) {
    .services-intro { grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); }
    .services-media { width: min(100% - 1.5rem, 340px); justify-self: end; margin-right: 1.5rem; }
  }

  .services-block { padding-top: clamp(3rem, 2rem + 4vw, 5rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .self-service {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
    padding: clamp(1.35rem, 1rem + 1vw, 1.9rem) clamp(1.35rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--c-lavender-300);
    border-radius: var(--radius-l);
    background: var(--c-lavender);
  }
  .self-service-copy { flex: 1 1 22rem; min-width: 0; }
  .self-service-q {
    font-family: var(--ff-serif);
    font-size: clamp(1.4rem, 1.2rem + .8vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--c-ink);
  }
  .self-service-sub { margin-top: .4rem; color: var(--c-ink-soft); font-size: var(--fs-body, 1.05rem); }
  .self-service-btn { flex: 0 0 auto; }
  @media (max-width: 599.98px) { .self-service-btn { width: 100%; } }
  .block-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .block-head .section-title { margin-bottom: 1rem; }
  .block-sub { max-width: 34rem; }
</style>
