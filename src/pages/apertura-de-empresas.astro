---
/**
 * /apertura-de-empresas/ — «Apertura de empresas» en España, México y Dubái
 * (docs/cambios-2026-10.md §2.3 y §2.9; antes /dubai/, que redirige aquí: netlify.toml y
 * `redirects` en astro.config.mjs).
 * - España y México: la cliente aún no ha enviado textos. Solo frases neutras y hechos que ya
 *   tenemos (web anterior: «Te ayudamos a crear tu negocio con estructura legal sólida» y
 *   «Emprende con visión internacional y
 *   seguridad»). PENDIENTE: textos de la cliente para España y México.
 * - Dubái (#dubai) conserva su contenido: textos de la web anterior (docs/web-anterior.md §2, §5
 *   y §7), tal cual, con las alertas de §9:
 * - 9.1 Fiscalidad: se OMITE la frase sin matices de la entradilla («sin impuestos sobre
 *   ganancias personales o empresariales») y se mantiene la versión matizada de «¿Por qué
 *   Dubái?» («en muchas zonas francas»), marcada abajo como pendiente de revisión legal.
 * - 9.2 La cifra «más de 1000 personas» NO se publica.
 * - Sin testimonios de plantilla («John DOE», «Iris DOE»).
 * Portada tipográfica (sin fotos de stock): arco con la celosía de ocho puntas (CSS + SVG en
 * línea, cero peticiones). El H1 es el LCP: no se oculta ni se anima. Movimiento contenido:
 * apariciones al hacer scroll y foco de luz en las tarjetas (solo ratón).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Faq from '~/components/ui/Faq.astro';
import PartnerCard from '~/components/dubai/PartnerCard.astro';
import ServiceRequestDialog from '~/components/services/ServiceRequestDialog.astro';
import { PHONE, TEL_LINK, EMAIL, WA_TEXT, waLink } from '~/data/site';
import { FAQ_DUBAI, faqJsonLd } from '~/data/faq';
import { dubai, companies } from '~/lib/services';
import { url } from '~/lib/url';

const requestWa = waLink(WA_TEXT.empresas);
const dubaiWa = waLink(WA_TEXT.dubai);
const countryWa = (name: string) => waLink(`Hola Denisse, me gustaría recibir información sobre la apertura de una empresa en ${name}.`);
const leadOf = (id: string) => companies.countries.find((c) => c.id === id)?.lead_value ?? '';

// Tarjetas de los tres países. PENDIENTE: textos de la cliente para España y México (frases
// neutras provisionales, sin datos de plazos, costes ni requisitos ni servicios concretos;
// «estructura legal sólida» queda solo en la entradilla para no repetirla).
const countryCards = [
  {
    id: 'espana',
    name: 'España',
    text: 'Te acompañamos en la creación de tu empresa en España desde el primer paso.',
  },
  {
    id: 'mexico',
    name: 'México',
    text: 'Si quieres emprender en México, te asesoramos para abrir allí tu empresa.',
  },
  {
    id: 'dubai',
    name: 'Dubái',
    text: 'Abre tu empresa en Dubái de forma legal, segura y rápida, sin necesidad de que residas allí.',
    detail: dubai.structures.join(' · '),
    anchor: '#dubai',
  },
].map((c) => ({ ...c, lead: leadOf(c.id) }));

const reasons = [
  {
    title: 'Ventajas fiscales',
    // PENDIENTE DE REVISIÓN LEGAL (alerta 9.1 de docs/web-anterior.md): es la versión matizada
    // del texto de la cliente. Desde los ejercicios iniciados a partir del 1/6/2023, EAU aplica
    // un impuesto federal de sociedades (9 % general); en zonas francas, 0 % solo sobre ingresos
    // cualificados; no hay impuesto sobre la renta personal. Confirmar la redacción con ella.
    text: 'Cero impuestos sobre beneficios personales o empresariales en muchas zonas francas.',
  },
  {
    title: 'Imagen, credibilidad e internacionalización',
    // Texto de la cliente, tal cual (docs/web-anterior.md §7).
    text: 'Tener tu empresa en Dubái abre puertas en mercados globales, mejora tu posicionamiento y establece tu empresa en una ubicación estratégica entre Europa, Asia y África.',
  },
  {
    title: '100% propiedad extranjera',
    text: 'Puedes ser el único propietario, sin necesidad de socios locales.',
  },
];

// «Constitución, apertura bancaria, fiscalidad y acompañamiento jurídico desde el primer paso»
// (bloque Dubái del inicio de la web anterior), en lista.
const support = ['Constitución', 'Apertura bancaria', 'Fiscalidad', 'Acompañamiento jurídico desde el primer paso'];
---

<BaseLayout
  title="Apertura de empresas en España, México y Dubái · DG Gestores y Abogados"
  description="Apertura de empresas en España, México y Dubái: te ayudamos a crear tu negocio. En Dubái, holding, real estate y trading, con un equipo local y nuestro partner. DG Gestores y Abogados, Madrid."
  ogImage="/og-empresas.jpg"
  ogImageAlt="Apertura de empresas en España, México y Dubái — DG Gestores y Abogados"
  preloadFonts={['serif-600', 'serif-500i', 'sans-400', 'sans-600']}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd(FAQ_DUBAI))} />
  </Fragment>

  <section class="dubai-hero" aria-labelledby="dubai-title">
    <div class="container dubai-hero-grid">
      <div class="dubai-hero-copy">
        <p class="eyebrow">Crea tu empresa</p>
        <h1 class="page-title dubai-title" id="dubai-title">Apertura de empresas <em>en España, México y Dubái</em></h1>
        <p class="lead dubai-lead">Te ayudamos a crear tu negocio con estructura legal sólida.</p>
        <div class="btn-row dubai-actions">
          <a class="btn btn--primary btn--lg" href={requestWa} target="_blank" rel="noopener" data-service-request="">
            <Icon name="message" />
            <span>Solicitar información</span>
          </a>
          <a class="btn btn--ghost btn--lg" href={requestWa} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            <span>Consultar por WhatsApp</span>
          </a>
        </div>
      </div>

      <div class="dubai-visual" aria-hidden="true">
        <div class="dubai-arch">
          <svg class="dubai-star" viewBox="0 0 100 100" focusable="false">
            <g fill="none" stroke="currentColor" stroke-width=".9">
              <path d="M29 29h42v42H29z" />
              <path d="M50 20.3 79.7 50 50 79.7 20.3 50z" />
              <circle cx="50" cy="50" r="12" />
            </g>
          </svg>
          <p class="dubai-arch-legend">
            <span>Empresas</span>
            <span class="dubai-arch-sub">España · México · Dubái</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white countries" aria-labelledby="countries-title">
    <div class="container">
      <div class="why-head">
        <p class="eyebrow" data-reveal>{companies.name}</p>
        <h2 class="section-title" id="countries-title" data-reveal>España, México y Dubái</h2>
      </div>
      <ul class="country-grid" role="list">
        {
          countryCards.map((c) => (
            <li class="country-card" id={c.id === 'dubai' ? undefined : c.id} data-reveal data-spotlight>
              <h3 class="country-name">{c.name}</h3>
              <p class="why-text">{c.text}</p>
              {c.detail && <p class="country-detail">{c.detail}</p>}
              {/* «Más sobre Dubái» va con el texto: el enlace principal queda abajo, a la misma
                  altura en las tres tarjetas. */}
              {c.anchor && (
                <a class="country-more" href={c.anchor}>
                  Más sobre Dubái
                </a>
              )}
              <div class="country-actions">
                <a class="btn btn--link" href={countryWa(c.name)} target="_blank" rel="noopener" data-service-request={c.lead}>
                  <span>
                    Solicitar información<span class="visually-hidden">{` sobre la apertura de empresas en ${c.name}`}</span>
                  </span>
                  <Icon name="arrow" />
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--ivory dubai-why" id="dubai" aria-labelledby="why-title">
    <div class="container">
      <div class="why-head">
        <p class="eyebrow" data-reveal>Dubái</p>
        <h2 class="section-title" id="why-title" data-reveal>¿Por qué Dubái?</h2>
      </div>
      <ul class="why-grid" role="list">
        {
          reasons.map((r, i) => (
            <li class="why-card" data-reveal data-spotlight>
              <span class="why-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="why-title">{r.title}</h3>
              <p class="why-text">{r.text}</p>
            </li>
          ))
        }
      </ul>
      {/* Una sola pregunta (de la web anterior): acordeón dentro de Dubái, sin bloque propio de
          «Preguntas frecuentes» (UX10). Su FAQPage de JSON-LD sigue en el <head>. */}
      <div class="dubai-faq" id="preguntas" data-reveal>
        <Faq items={FAQ_DUBAI} />
        <p class="faq-cross">
          ¿Tu consulta es sobre extranjería en España? <a href={url('/servicios/#preguntas')}>Preguntas frecuentes de extranjería</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--white dubai-services" aria-labelledby="structures-title">
    <div class="container services-grid">
      <div class="services-copy">
        <p class="eyebrow" data-reveal>Servicios</p>
        <h2 class="section-title" id="structures-title" data-reveal>Apertura de empresas en Dubái</h2>
        {/* «ventajas fiscales»: texto de la cliente; ver alerta 9.1 (pendiente de revisión legal). */}
        <p class="lead" data-reveal>Expande tu negocio internacionalmente. Te asesoramos en la creación de empresas en Dubái con estructuras legales eficientes y ventajas fiscales.</p>
      </div>
      <ul class="structures" role="list" aria-label="Estructuras">
        {
          dubai.structures.map((s, i) => (
            <li class="structure" data-reveal>
              <span class="structure-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="structure-name">{s}</span>
            </li>
          ))
        }
      </ul>
      <div class="support" data-reveal>
        <h3 class="support-title">Cómo te acompañamos en Dubái</h3>
        <ul class="check-list support-list" role="list">
          {
            support.map((item) => (
              <li>
                <Icon name="check" />
                {item}
              </li>
            ))
          }
        </ul>
        <a class="btn btn--link support-ask" href={dubaiWa} target="_blank" rel="noopener" data-service-request={dubai.lead_value}>
          <span>Información sobre Dubái</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section dubai-local" aria-labelledby="local-title">
    <div class="container">
      <div class="local-statement">
        <h2 class="local-title" id="local-title" data-reveal>Trabajamos con un equipo local en Dubái, lo que nos permite ofrecerte un servicio completo, confiable y transparente.</h2>
        <p class="local-close" data-reveal>Tú nos explicas tu idea, y nosotros nos encargamos del resto.</p>
      </div>
      <div data-reveal>
        <PartnerCard link="external" headingId="dubai-partner-title" />
      </div>
    </div>
  </section>

  <section class="section dubai-cta" aria-labelledby="dubai-cta-title" data-wa-hide>
    <div class="container dubai-cta-grid">
      <div>
        <p class="eyebrow" data-reveal>Contacto</p>
        <h2 class="section-title" id="dubai-cta-title" data-reveal>Emprende con visión internacional y seguridad.</h2>
      </div>
      <div class="dubai-cta-actions" data-reveal>
        <a class="btn btn--primary btn--lg btn--block" href={requestWa} target="_blank" rel="noopener" data-service-request="">
          <Icon name="message" />
          <span>Solicitar información</span>
        </a>
        <a class="btn btn--ghost btn--lg btn--block" href={requestWa} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span>Consultar por WhatsApp</span>
        </a>
        <div class="dubai-cta-direct">
          <a href={TEL_LINK}><Icon name="phone" /><span>{PHONE.display}</span></a>
          <a href={EMAIL.href}><Icon name="mail" /><span>{EMAIL.user}<wbr />@{EMAIL.domain}</span></a>
        </div>
      </div>
    </div>
  </section>

  <ServiceRequestDialog slot="after" kicker={companies.name} waText={WA_TEXT.empresas} messageHint="Por ejemplo, en qué país quieres abrir tu empresa, tu situación actual o tu idea de negocio." />
</BaseLayout>

<script>
  // Foco de luz en las tarjetas de países y de «¿Por qué Dubái?» (solo ratón; global.css §6).
  import { initSpotlight } from '~/scripts/spotlight';
  initSpotlight();
</script>

<style>
  /* ---------- Portada ---------- */
  .dubai-hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3rem, 2rem + 4vw, 6rem);
    overflow: clip;
    background:
      radial-gradient(60rem 40rem at 100% 0%, rgba(232, 221, 236, .85), transparent 62%),
      radial-gradient(40rem 30rem at 0% 100%, rgba(247, 238, 232, .9), transparent 70%),
      var(--c-ivory);
  }
  /* Celosía muy tenue en la esquina superior derecha (se funde hacia el texto). */
  .dubai-hero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto auto;
    width: min(100%, 56rem);
    height: 100%;
    z-index: -1;
    background: var(--lattice-plum) 0 0 / 60px 60px;
    opacity: .07;
    -webkit-mask-image: radial-gradient(70% 80% at 100% 0%, #000 20%, transparent 75%);
    mask-image: radial-gradient(70% 80% at 100% 0%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .dubai-hero-grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  .dubai-title { margin-bottom: 1.5rem; max-width: 9em; }
  .dubai-title em { display: block; }
  .dubai-lead { max-width: 34rem; }
  .dubai-actions { margin-top: 2rem; }

  .dubai-visual {
    position: relative;
    isolation: isolate;
    width: min(100% - 1.5rem, 300px);
    justify-self: center;
  }
  .dubai-visual::before {
    content: "";
    position: absolute;
    inset: -10px -8px 10px 8px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-pill) var(--radius-pill) 22px 22px;
    pointer-events: none;
  }
  .dubai-arch {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-pill) var(--radius-pill) 18px 18px;
    overflow: hidden;
    color: var(--ev-gold);
    background:
      radial-gradient(70% 45% at 50% 0%, rgba(221, 181, 108, .28), transparent 70%),
      linear-gradient(to bottom, rgba(31, 16, 36, 0) 45%, rgba(31, 16, 36, .85) 100%),
      linear-gradient(rgba(44, 10, 50, .32), rgba(44, 10, 50, .32)),
      var(--lattice-gold) 50% 0 / 60px 60px,
      linear-gradient(170deg, #4A1554 0%, var(--c-plum-900) 55%, var(--ev-bg) 100%);
    box-shadow: var(--shadow);
  }
  .dubai-star { width: 42%; margin-top: -18%; opacity: .95; }
  .dubai-arch-legend {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.6rem;
    display: grid;
    gap: .35rem;
    text-align: center;
    color: var(--ev-text);
    font-family: var(--ff-serif);
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1;
  }
  .dubai-arch-sub {
    color: var(--ev-gold);
    font-family: var(--ff-sans);
    font-size: .68rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: uppercase;
  }
  @media (max-width: 479.98px) {
    .dubai-actions .btn { width: 100%; }
  }
  @media (min-width: 600px) {
    .dubai-visual { width: min(100% - 1.5rem, 340px); }
    .dubai-visual::before { inset: -14px -14px 14px 14px; }
  }
  @media (min-width: 960px) {
    .dubai-hero-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: clamp(2.5rem, 4vw, 4rem); }
    .dubai-visual { width: 100%; max-width: 400px; justify-self: end; }
  }

  /* ---------- España, México y Dubái ---------- */
  .country-grid { display: grid; gap: 1.25rem; }
  .country-card {
    display: flex;
    flex-direction: column;
    gap: .85rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--c-ivory);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    scroll-margin-top: 6rem;
    transition: border-color var(--dur) var(--ease-hover), box-shadow var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .country-card:hover { border-color: var(--c-line-strong); box-shadow: var(--shadow-s); }
  }
  .country-name {
    font-family: var(--ff-serif);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.6rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1;
    color: var(--c-plum);
  }
  .country-detail { color: var(--c-ink); font-size: .8rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .country-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1.5rem; margin-top: auto; padding-top: .25rem; }
  .country-more {
    align-self: flex-start;
    margin-top: -.5rem;
    padding-block: .5rem;
    color: var(--c-ink-soft);
    font-size: .95rem;
    text-decoration: underline;
    text-decoration-color: var(--c-line-strong);
    text-underline-offset: .2em;
  }
  @media (hover: hover) {
    .country-more:hover { color: var(--c-plum); text-decoration-color: currentColor; }
  }
  @media (min-width: 900px) {
    .country-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  }
  .dubai-why { scroll-margin-top: 4rem; }
  .support-ask { margin-top: 1.5rem; justify-content: flex-start; }

  /* ---------- ¿Por qué Dubái? ---------- */
  .why-head { margin-bottom: clamp(2.25rem, 4vw, 3.25rem); }
  .why-grid { display: grid; gap: 1.25rem; }
  .why-card {
    display: flex;
    flex-direction: column;
    gap: .9rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    transition: border-color var(--dur) var(--ease-hover), box-shadow var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .why-card:hover { border-color: var(--c-line-strong); box-shadow: var(--shadow-s); }
  }
  .why-num {
    font-family: var(--ff-serif);
    font-size: 2.6rem;
    font-weight: 500;
    font-style: italic;
    line-height: 1;
    color: var(--c-plum);
  }
  .why-title {
    font-family: var(--ff-serif);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }
  .why-text { color: var(--c-ink-soft); line-height: 1.6; text-wrap: pretty; }
  @media (min-width: 900px) {
    .why-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  }

  /* ---------- Servicios: Holding · Real Estate · Trading ---------- */
  .services-grid { display: grid; gap: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 6rem); }
  .services-copy .section-title { margin-bottom: 1.25rem; max-width: 9em; }
  .services-copy .lead { max-width: 34rem; }
  .structures { display: grid; border-top: 1px solid var(--c-line-strong); align-self: start; }
  .structure {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0 1.2rem;
    border-bottom: 1px solid var(--c-line-strong);
  }
  .structure-num { flex: 0 0 auto; min-width: 2.6ch; color: var(--c-plum); font-size: .78rem; font-weight: 600; letter-spacing: .2em; font-variant-numeric: tabular-nums; }
  .structure-name {
    font-family: var(--ff-serif);
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3.2rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1;
    color: var(--c-ink);
  }
  .support {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--c-ivory);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
  }
  .support-title {
    margin-bottom: 1.25rem;
    font-family: var(--ff-serif);
    font-size: clamp(1.35rem, 1.2rem + .6vw, 1.65rem);
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
  }
  @media (min-width: 700px) {
    .support-list { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 960px) {
    .services-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .support { grid-column: 1 / -1; }
  }

  /* ---------- Equipo local + partner (banda ciruela) ---------- */
  .dubai-local {
    --focus: #fff;
    color: var(--c-lavender);
    background:
      radial-gradient(50rem 30rem at 90% 10%, rgba(146, 58, 160, .45), transparent 65%),
      linear-gradient(160deg, #3A0E42 0%, var(--c-plum-800) 55%, #2A0930 100%);
    overflow: clip;
  }
  .local-statement { max-width: 56rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .local-title {
    font-family: var(--ff-serif);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.9rem);
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
    text-wrap: pretty;
  }
  .local-close {
    display: flex;
    align-items: center;
    gap: .85rem;
    margin-top: 1.5rem;
    color: var(--ev-gold-2);
    font-family: var(--ff-serif);
    font-size: clamp(1.3rem, 1.15rem + .7vw, 1.7rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
  }
