---
/**
 * Plantilla común de todas las páginas: <head> (SEO, Open Graph, canonical, JSON-LD,
 * tipografías, iconos), enlace «Saltar al contenido», cabecera, pie y WhatsApp flotante.
 *
 * Transiciones entre páginas: View Transitions entre documentos, solo CSS
 * (src/styles/global.css §8). Sin router en el cliente.
 */
import '~/styles/global.css';
import { SITE } from '~/data/site';
import { absoluteUrl, url, normalizePath } from '~/lib/url';
import Fonts, { type FontKey } from '~/components/seo/Fonts.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import WhatsAppFloat from '~/components/layout/WhatsAppFloat.astro';
import { UTM_KEYS, UTM_STORAGE_KEY } from '~/config/acciogest';

interface Props {
  /** <title> completo. */
  title: string;
  description: string;
  /** Imagen para redes (ruta en public/ o URL absoluta). */
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Tipografías a precargar en esta página (ver Fonts.astro). */
  preloadFonts?: FontKey[];
  /** Clase para <body> (p. ej. tema oscuro de Empoderando Voces). */
  bodyClass?: string;
  /** Color de la barra del navegador en móvil. */
  themeColor?: string;
  /** Tono de la cabecera: «dark» = translúcida oscura (Empoderando Voces). */
  headerTone?: 'light' | 'dark';
}

const {
  title,
  description,
  ogImage = '/og-image.jpg',
  ogImageAlt = 'Denisse González, abogada: «Derecho con estrategia. Derecho con perspectiva internacional. Derecho con humanidad.»',
  noindex = false,
  preloadFonts,
  bodyClass,
  themeColor = SITE.themeColor,
  headerTone = 'light',
} = Astro.props;

const path = normalizePath(Astro.url.pathname);
const canonical = absoluteUrl(path, Astro.site);
const ogImageUrl = absoluteUrl(ogImage, Astro.site);

// Precarga/prerenderizado de las páginas internas al pasar el ratón o tocar un enlace
// (Speculation Rules: nativo, sin JavaScript). Hace las transiciones casi instantáneas.
const speculationRules = JSON.stringify({
  prerender: [
    {
      where: {
        and: [
          { href_matches: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/*` },
          { not: { selector_matches: '[target=_blank], [download], [data-no-prerender]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
});

// UTM de la URL de llegada → sessionStorage, en TODAS las páginas (los formularios de AccioGest
// las envían aunque la persona llegue a otra página). En línea y diminuto: sin petición extra.
// Retrato compartido inicio ↔ Conóceme (View Transitions entre documentos, global.css §8).
// Se nombra «portrait» SOLO la foto .vt-portrait que más se ve en pantalla en cada lado
// (pageswap en la página que se va, pagereveal en la que llega) y solo entre esas dos páginas;
// si no se ve ninguna, transición normal. Si es la misma foto (p. ej. la de la ONU en ambas),
// tipo «portrait-same» (fundido cruzado sin desenfoque). Con «reducir movimiento» no se nombra
// nada (solo el fundido de la página). Sin soporte: no hace nada.
const vtHome = url('/');
const vtAbout = url('/conoceme/');
const portraitScript = `(function(){if(!('onpagereveal' in window))return;var H=${JSON.stringify(vtHome)},A=${JSON.stringify(vtAbout)},K='vt-portrait';function p(u){try{return new URL(u,location.href).pathname}catch(e){return''}}function linked(a,b){return(a===H&&b===A)||(a===A&&b===H)}function photo(el){var i=el.querySelector('img');return i?(i.currentSrc||i.src).split('/').pop().split('.')[0]:''}function pick(){var best=null,score=.3;if(matchMedia('(prefers-reduced-motion: reduce)').matches)return null;document.querySelectorAll('.vt-portrait').forEach(function(el){var r=el.getBoundingClientRect();if(!r.width||!r.height)return;var w=Math.min(r.right,innerWidth)-Math.max(r.left,0),h=Math.min(r.bottom,innerHeight)-Math.max(r.top,0),s=w>0&&h>0?w*h/(r.width*r.height):0;if(s>=score){score=s;best=el}});return best}function name(el,vt){el.style.viewTransitionName='portrait';vt.finished.finally(function(){el.style.viewTransitionName=''})}addEventListener('pageswap',function(e){if(!e.viewTransition||!e.activation||!e.activation.entry||!linked(p(location.href),p(e.activation.entry.url)))return;var el=pick();try{sessionStorage.setItem(K,el?photo(el)||'?':'')}catch(x){}if(el)name(el,e.viewTransition)});addEventListener('pagereveal',function(e){if(!e.viewTransition)return;var n=window.navigation&&navigation.activation,from=n&&n.from&&n.from.url?p(n.from.url):document.referrer?p(document.referrer):'';if(!linked(from,p(location.href)))return;var was=null;try{was=sessionStorage.getItem(K);sessionStorage.removeItem(K)}catch(x){}if(was==='')return;var el=pick();if(!el)return;if(was&&photo(el)===was)e.viewTransition.types.add('portrait-same');name(el,e.viewTransition)});addEventListener('pageshow',function(){document.querySelectorAll('.vt-portrait').forEach(function(el){el.style.viewTransitionName=''})})})();`;

const utmScript = `try{var q=new URLSearchParams(location.search),u={},n=0;${JSON.stringify(UTM_KEYS)}.forEach(function(k){var v=(q.get(k)||'').trim();if(v){u[k]=v.slice(0,200);n++}});if(n)sessionStorage.setItem(${JSON.stringify(UTM_STORAGE_KEY)},JSON.stringify(u))}catch(e){}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />

    <Fonts preload={preloadFonts} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <JsonLd title={title} description={description} path={path} />
    <script type="speculationrules" is:inline set:html={speculationRules} />
    <script is:inline set:html={utmScript} />
    <script is:inline set:html={portraitScript} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header tone={headerTone} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <slot name="after" />
    <script>
      // Aparición única al hacer scroll (sistema de movimiento: global.css §9).
      import { initReveal } from '~/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
